{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "geometry-work-manager/snapshot-v1",
  "title": "Geometry work manager validated snapshot v1",
  "$comment": "Read-path store_health validates legacy ledger rows and immutable proof identities. Invalid data returns diagnostic JSON, no actionable work or done claims, keeps exact original bytes in a private checksum backup, and rejects writes/restore. node_kind=umbrella and parent_id are grouping associations, not executable work or dependencies. Inventory rows reference registered task IDs; complete lists replace only their repository registry, partial lists merge, older/error sources cannot clear coverage. Counts are distinct repository/number; any linked work slice missing scope/files marks the issue scope missing. Inventory/source-CI semantic bodies are included in payload_hash without observation headers; inventory never changes task proofs, owners or action pins. Source CI is an observation bound to source_sha, not a work node, and runner=0 or missing meaningful steps is not_run. Read-only CLI coverage exposes the canonical registry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "events"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "version", "as_of", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["manual_snapshot", "git", "github", "operator"]},
        "version": {"type": "integer", "minimum": 1},
        "as_of": {"type": "string", "format": "date-time"},
        "status": {"enum": ["ok", "error"]},
        "url": {"$ref": "#/$defs/url"}, "source_sha": {"$ref": "#/$defs/sha"},
        "error": {"type": "string"},
        "ci": {"type": "array", "items": {"$ref": "#/$defs/ciJob"}},
        "ci_runs": {"type": "array", "items": {"$ref": "#/$defs/ciRun"}}
      }
    },
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "issue_inventory": {"$ref": "#/$defs/issueInventory"},
    "pr_inventory": {"$ref": "#/$defs/prInventory"}
  },
  "$defs": {
    "issueInventory": {
      "type": "object", "additionalProperties": false, "required": ["repository", "complete", "issues"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "complete": {"type": "boolean"},
        "issues": {"type": "array", "maxItems": 5000, "items": {
          "type": "object", "additionalProperties": false, "required": ["number", "url", "task_ids"],
          "properties": {
            "number": {"type": "integer", "minimum": 1}, "url": {"$ref": "#/$defs/url"},
            "task_ids": {"$ref": "#/$defs/textList"},
            "title": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}
          }
        }}
      }
    },
    "prInventory": {
      "type": "object", "additionalProperties": false, "required": ["repository", "complete", "prs"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "complete": {"type": "boolean"},
        "prs": {"type": "array", "maxItems": 5000, "items": {
          "type": "object", "additionalProperties": false, "required": ["number", "url", "task_ids"],
          "properties": {
            "number": {"type": "integer", "minimum": 1}, "url": {"$ref": "#/$defs/url"},
            "task_ids": {"$ref": "#/$defs/textList"},
            "title": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
            "head_sha": {"$ref": "#/$defs/sha"}, "base_sha": {"$ref": "#/$defs/sha"},
            "base": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
            "draft": {"type": ["boolean", "null"]}, "merged": {"type": ["boolean", "null"]}
          }
        }}
      }
    },
    "sha": {"type": ["string", "null"], "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
    "url": {"type": "string", "pattern": "^https?://", "maxLength": 2048},
    "text": {"type": "string", "minLength": 1, "maxLength": 4000},
    "textList": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "time": {"type": "string", "format": "date-time"},
    "executionStatus": {"enum": ["unknown", "unassigned", "active", "stopped", "blocked", "finished"]},
    "ciStatus": {"enum": [null, "queued", "in_progress", "completed", "pending", "waiting", "requested"]},
    "ciConclusion": {"enum": [null, "success", "passed", "failure", "failed", "neutral", "cancelled", "skipped", "timed_out", "action_required", "stale", "startup_failure", "unknown"]},
    "ciIdentity": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1, "maxLength": 200}]},
    "ciStep": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/text"}, "status": {"$ref": "#/$defs/ciStatus"},
        "conclusion": {"$ref": "#/$defs/ciConclusion"}, "number": {"type": "integer", "minimum": 0},
        "started_at": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
        "completed_at": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]}
      }
    },
    "ciSteps": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/ciStep"}},
    "completedAction": {
      "type": "object", "additionalProperties": false, "required": ["action", "input_pin", "timestamp"],
      "properties": {
        "action": {"enum": ["review_pr", "review_integration", "verify_acceptance", "verify_scope", "verify_source", "collect_result", "resolve_blocker", "continue_work"]},
        "input_pin": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "timestamp": {"$ref": "#/$defs/time"}, "summary": {"$ref": "#/$defs/text"}
      }
    },
    "taskData": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "title": {"$ref": "#/$defs/text"},
        "scope": {"$ref": "#/$defs/text"},
        "branch": {"$ref": "#/$defs/text"},
        "files": {"$ref": "#/$defs/textList"},
        "dependencies": {"$ref": "#/$defs/textList"},
        "required_acceptance": {"$ref": "#/$defs/textList"},
        "head_sha": {"$ref": "#/$defs/sha"},
        "head_tree_sha": {"$ref": "#/$defs/sha"},
        "node_kind": {"enum": ["work", "umbrella"], "default": "work"},
        "parent_id": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 200}, {"type": "null"}]},
        "not_before": {"oneOf": [{"$ref": "#/$defs/time"}, {"type": "null"}]},
        "refs": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["kind", "url"],
            "properties": {"kind": {"$ref": "#/$defs/text"}, "url": {"$ref": "#/$defs/url"}, "number": {"type": "integer", "minimum": 1}}
          }
        },
        "approval_constraints": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["action", "status"],
            "properties": {
              "action": {"$ref": "#/$defs/text"}, "status": {"enum": ["required", "granted", "denied"]},
              "scope": {"enum": ["action", "completion"], "default": "completion"},
              "reason": {"$ref": "#/$defs/text"}
            }
          }
        }
      }
    },
    "assignmentData": {
      "type": "object", "additionalProperties": false, "required": ["execution_status"],
      "properties": {
        "owner_thread": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 200}, {"type": "null"}]},
        "execution_status": {"$ref": "#/$defs/executionStatus"},
        "reserved": {"type": "boolean"}, "reason": {"$ref": "#/$defs/text"},
        "files": {"$ref": "#/$defs/textList"}
      },
      "allOf": [{
        "if": {"properties": {"execution_status": {"const": "active"}}},
        "then": {"required": ["owner_thread"], "properties": {"owner_thread": {"type": "string", "minLength": 1}}}
      }]
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "criterion", "kind", "timestamp", "sha", "result"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "criterion": {"$ref": "#/$defs/text"},
        "kind": {"$ref": "#/$defs/text"}, "timestamp": {"$ref": "#/$defs/time"},
        "sha": {"$ref": "#/$defs/sha"}, "result": {"enum": ["passed", "failed", "unknown"]},
        "tree_sha": {"$ref": "#/$defs/sha"}, "equivalent_head_sha": {"$ref": "#/$defs/sha"},
        "url": {"$ref": "#/$defs/url"}, "runner_id": {"type": "integer", "minimum": 0},
        "steps": {"$ref": "#/$defs/ciSteps"}, "expires_at": {"$ref": "#/$defs/time"},
        "summary": {"$ref": "#/$defs/text"}
      }
    },
    "ciJob": {
      "type": "object", "additionalProperties": false, "required": ["name", "sha", "status", "conclusion"],
      "properties": {
        "name": {"$ref": "#/$defs/text"}, "sha": {"$ref": "#/$defs/sha"},
        "status": {"$ref": "#/$defs/ciStatus"}, "conclusion": {"$ref": "#/$defs/ciConclusion"},
        "runner_id": {"type": "integer", "minimum": 0}, "steps": {"$ref": "#/$defs/ciSteps"},
        "url": {"$ref": "#/$defs/url"},
        "id": {"$ref": "#/$defs/ciIdentity"}, "run_id": {"$ref": "#/$defs/ciIdentity"},
        "attempt": {"type": "integer", "minimum": 1}
      }
    },
    "ciRun": {
      "type": "object", "additionalProperties": false,
      "description": "An observed run, not a synthetic job. Effective success requires exact SHA, completed success, positive job_count matching real jobs, and executed passing jobs. Empty runs, missing jobs or failed run conclusions cannot pass. Job run_id/attempt preserves distinct same-name jobs across runs. Runs are projected with effective_result and observed_job_count; their semantic fields participate in action pins, without observation timestamps.",
      "required": ["id", "sha", "status", "conclusion", "job_count"],
      "properties": {
        "id": {"$ref": "#/$defs/ciIdentity"}, "sha": {"$ref": "#/$defs/sha"},
        "status": {"$ref": "#/$defs/ciStatus"}, "conclusion": {"$ref": "#/$defs/ciConclusion"},
        "attempt": {"type": "integer", "minimum": 1}, "url": {"$ref": "#/$defs/url"},
        "job_count": {"type": "integer", "minimum": 0}
      }
    },
    "prMetadata": {
      "type": "object", "additionalProperties": false, "required": ["number", "url", "updated_at"],
      "description": "Safe published-PR metadata patch. Same number and normalized URL preserve existing review; a different identity starts unknown and cannot inherit review or CI. Review, owner and approval fields are forbidden. Work head explicitly supplied in task.head_sha/result.head_sha remains a separate fact and is never overwritten by published metadata, even with a later updated_at. Only a PR-inferred task head may advance from metadata.updated_at, and same-head refresh does not advance head_changed_at. Projection exposes published_head_sha and head_alignment same/different/unknown; differences require verification. Omitted CI keeps previously known raw jobs/runs; source observations likewise retain omitted CI with its original ci_observed_at and make it stale on a source SHA change.",
      "properties": {
        "number": {"type": "integer", "minimum": 1}, "url": {"$ref": "#/$defs/url"},
        "updated_at": {"$ref": "#/$defs/time"}, "head_sha": {"$ref": "#/$defs/sha"},
        "merged": {"type": "boolean"}, "draft": {"type": "boolean"},
        "ci": {"type": "array", "items": {"$ref": "#/$defs/ciJob"}},
        "ci_runs": {"type": "array", "items": {"$ref": "#/$defs/ciRun"}}
      }
    },
    "pr": {
      "type": "object", "additionalProperties": false,
      "required": ["number", "url", "head_sha", "merged", "review_state"],
      "properties": {
        "number": {"type": "integer", "minimum": 1}, "url": {"$ref": "#/$defs/url"},
        "head_sha": {"$ref": "#/$defs/sha"}, "merged_head_sha": {"$ref": "#/$defs/sha"},
        "reviewed_sha": {"$ref": "#/$defs/sha"}, "merge_commit_sha": {"$ref": "#/$defs/sha"},
        "merged": {"type": "boolean"}, "draft": {"type": "boolean"},
        "review_state": {"enum": ["unknown", "pending", "approved", "changes_requested"]},
        "ci": {"type": "array", "items": {"$ref": "#/$defs/ciJob"}},
        "ci_runs": {"type": "array", "items": {"$ref": "#/$defs/ciRun"}},
        "updated_at": {"$ref": "#/$defs/time"}
      }
    },
    "resultData": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "head_sha": {"$ref": "#/$defs/sha"},
        "pr": {"oneOf": [{"$ref": "#/$defs/pr"}, {"type": "null"}]},
        "pr_metadata": {"$ref": "#/$defs/prMetadata"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "completed_actions": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/completedAction"}},
        "execution_status": {"$ref": "#/$defs/executionStatus"},
        "owner_thread": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 200}, {"type": "null"}]},
        "summary": {"$ref": "#/$defs/text"}
      },
      "not": {"required": ["pr", "pr_metadata"]}
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "task_id", "kind", "version", "occurred_at", "data"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1}, "task_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["task", "assignment", "result", "github"]},
        "version": {"type": "integer", "minimum": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "data": {"type": "object", "minProperties": 1}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "task"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/taskData"}}}},
        {"if": {"properties": {"kind": {"const": "assignment"}}}, "then": {"properties": {"data": {"$ref": "#/$defs/assignmentData"}}}},
        {"if": {"properties": {"kind": {"enum": ["result", "github"]}}}, "then": {"properties": {"data": {"$ref": "#/$defs/resultData"}}}}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"source": {"properties": {"status": {"const": "error"}}}}}, "then": {
      "properties": {"events": {"maxItems": 0}, "source": {"not": {"anyOf": [{"required": ["ci"]}, {"required": ["ci_runs"]}]}}},
      "not": {"anyOf": [{"required": ["issue_inventory"]}, {"required": ["pr_inventory"]}]}
    }}
  ],
  "description": "store.py validate_snapshot / validate_event are normative, dependency-free validators. They also enforce canonical relative paths, safe URLs, timezone-aware times, scalar enums, stream version gates and the 8 MiB snapshot bound. Entire projection validation occurs before transaction commit. Unknown SHA is null. Events are partial updates; omitted tasks/fields are retained. Evidence identity (task_id,id) is immutable; exact duplicates are idempotent, conflicting bodies reject the whole transaction. New attempts need new IDs. Completion-scoped unmet approvals (the default) block done and dependency release; explicit action scope preserves historical integration while retaining the future action hold. Requests never grant approval. Aggregate approved requires exact pr.reviewed_sha before it is effective. Every required acceptance, exact merged head and effective review must hold for done. Only local_test can bind a different tested SHA via exact task.head_tree_sha = evidence.tree_sha and current head = equivalent_head_sha. Only postmerge_test can bind to pr.merge_commit_sha when the merged PR head also exactly matches the current head. Original evidence.sha is never rewritten. CI/review do not use tree equivalence. The latest applicable current-head proof wins; stale-head history cannot displace it, while a newer applicable failed/future/expired proof fails closed. completed_actions receipts bind known actions to next_action_pin, suppress only identical meaningful inputs and never grant permissions; local record-result requires the current action/pin. The projection displays the most recent 100 unique receipts per task while the append-only ledger retains all. New successful source observations repeating current immutable event IDs advance per-task last_verified_at without adding events; absent tasks and failed fetches are not refreshed. payload_hash covers applied immutable semantic records, excluding observation/freshness; state_hash covers the full projection except generated_at. next_action_mode distinguishes read_only/write/wait/none, and list-ready --mode filters only actionable items. Local record commands accept a full one-event snapshot or {event_id,task_id,version,occurred_at,source_id?,data}; source_id defaults to local-operator. Record-assignment checks scope/approval/dependency/schedule/owner conflicts. Restore permits only an empty or identical destination and validates checksum and full projection atomically."
}
