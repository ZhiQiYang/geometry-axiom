{
  "_comment": "範例:node qa_cdp.js example_script.json 。launch 參數同 qa.launch();步驟逐一以真實輸入事件執行。",
  "launch": {"port": 9415, "profileDir": "<TEMP>/geometry-qa/chrome-example", "width": 1440, "height": 900, "mobile": false},
  "url": "http://localhost:8831/",
  "outDir": "<QA>/env/example-out",
  "steps": [
    {"do": "screenshot", "file": "s01-home.png"},
    {"do": "click", "target": "#fileMenuBtn"},
    {"do": "chooseFile", "files": ["<QA>/env/fixtures/synthetic_portrait_2page.pdf"]},
    {"do": "click", "target": "#btnImportReference"},
    {"do": "waitChooser"},
    {"do": "waitSelector", "target": "#refApply:not([disabled])", "timeout": 15000},
    {"do": "assertText", "target": "#referenceDialog", "contains": "synthetic_portrait_2page.pdf"},
    {"do": "screenshot", "file": "s02-reference-dialog.png"},
    {"do": "press", "key": "Escape"},
    {"do": "wheel", "target": "#ocv", "deltaY": -300, "modifiers": 2},
    {"do": "drag", "from": [800, 500], "to": [1000, 560]},
    {"do": "press", "key": "ctrl+z"},
    {"do": "screenshot", "file": "s03-after-input.png"},
    {"do": "consoleErrors"}
  ]
}
