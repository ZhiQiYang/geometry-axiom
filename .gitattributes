tests/suites.d/** text eol=lf
tests/native-costs.d/** text eol=lf
tests/registry-layout.json text eol=lf
tests/registry-evidence/*.json text eol=lf
tests/registry-evidence/native-amendments/** text eol=lf
tests/registry-source-reviews/** text eol=lf
geometry-web/cdp_sections.d/** text eol=lf
geometry-web/canvas_sections/** text eol=lf
geometry-core/domain-decoupling/product-architecture.json text eol=lf
geometry-core/domain-decoupling/product-architecture.d/** text eol=lf
