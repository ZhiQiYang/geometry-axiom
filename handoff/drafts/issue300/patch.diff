+++ b/tests/test_geo261_timber_capacity.py
@@ -0,0 +1,297 @@
+"""GEO #300: one timber capacity, exact N / N+1 behaviour, and controls with teeth.
+
+The capacity (WOOD_MEMBER_CAPACITY in members.h) is the only definition. The other
+four names (WORLD_MAX_TIMBERS and the contact, report and span scratch bounds) must
+derive from it, and the host checks the derivations at compile time. Every walk of
+the boundary uses the production macros or the value read from members.h; the one
+pinned number lives in the C harness (case "values").
+
+A control counts only when the baseline passes, the changed build fails the NAMED
+assertion (or, for a compile-time binding, the build fails naming the check), and the
+restored baseline passes again. Native crashes and unrelated build errors are not
+detections.
+"""
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+from tests import _bridge
+from tests.test_geo261_native_kernel import native
+from tests.test_geo261_wood_world_validation import PRODUCT_DEFINES, copy_product_closure
+
+W = ROOT / "geometry-templates/woodworking/native"
+HOST = ROOT / "current_geometry.c"
+HARNESS = ROOT / "tests/geo261_timber_capacity_harness.c"
+REPORT_HARNESS = ROOT / "tests/geo261_report_policy_harness.c"
+OVER_CAPACITY = "角材的數量超過上限"
+CAPACITY = int(re.search(r"^#define WOOD_MEMBER_CAPACITY (\d+)\s*$", (W / "members.h").read_text(encoding="utf-8"), re.M).group(1))
+
+DERIVED = {
+    "WORLD_MAX_TIMBERS": "current_geometry.c",
+    "WOOD_CONTACT_MEMBER_CAPACITY": "geometry-templates/woodworking/native/contact_world.h",
+    "WOOD_CUT_LIST_MEMBER_CAPACITY": "geometry-templates/woodworking/native/cut_list.h",
+    "WOOD_MEMBER_SPAN_MEMBER_CAPACITY": "geometry-templates/woodworking/native/member_reference.h",
+}
+PRODUCT_GLOBS = ("current_geometry.c", "geometry-core/*.c", "geometry-core/*.h", "geometry-core/*.inc",
+                 "geometry-core/kernel/*.c", "geometry-core/kernel/*.h", "geometry-core/kernel/internal/*.h",
+                 "geometry-app/native/*", "geometry-templates/woodworking/native/*",
+                 "geometry-web/*.c", "geometry-web/*.h", "geometry-web/*.inc")
+
+
+def read(path):
+    return Path(path).read_bytes().decode("utf-8").replace("\r\n", "\n")
+
+
+def strip_comments(text):
+    return re.sub(r"/\*.*?\*/|//[^\n]*", "", text, flags=re.S)
+
+
+def product_sources():
+    seen = set()
+    for pattern in PRODUCT_GLOBS:
+        for path in sorted(ROOT.glob(pattern)):
+            if path.suffix in (".c", ".h", ".inc") and path not in seen:
+                seen.add(path)
+                yield path
+
+
+class TimberCapacitySource(unittest.TestCase):
+    def test_one_definition_and_every_other_name_is_derived_from_it(self):
+        definitions = {}
+        names = "|".join(["WOOD_MEMBER_CAPACITY", *DERIVED])
+        for path in product_sources():
+            text = read(path)
+            relative = path.relative_to(ROOT).as_posix()
+            for match in re.finditer(r"^[ \t]*#[ \t]*define[ \t]+(" + names + r")\b[ \t]*([^\n]*)$", text, re.M):
+                value = re.sub(r"/\*.*?\*/|//.*$", "", match.group(2)).strip()
+                definitions.setdefault(match.group(1), []).append((relative, value))
+            self.assertIsNone(re.search(r"\bWOOD_MEMBER_CAPACITY\s*=[^=]", strip_comments(text)),
+                              relative + " must not turn the capacity back into an enum constant")
+        self.assertEqual([("geometry-templates/woodworking/native/members.h", str(CAPACITY))],
+                         definitions.get("WOOD_MEMBER_CAPACITY"))
+        for name, relative in DERIVED.items():
+            self.assertEqual([(relative, "WOOD_MEMBER_CAPACITY")], definitions.get(name),
+                             name + " must be exactly one alias of WOOD_MEMBER_CAPACITY")
+
+    def test_host_hands_the_single_constant_to_every_capacity_consumer(self):
+        host = read(HOST)
+        self.assertEqual(1, host.count("&world->wood.timber_count,WORLD_MAX_TIMBERS,"))
+        self.assertIn("c.member_capacity=WORLD_MAX_TIMBERS;", read(ROOT / "geometry-core/assembly.inc"))
+        self.assertIn("o.member_capacity=WORLD_MAX_TIMBERS;", read(ROOT / "geometry-core/engineering_commands.inc"))
+        support = read(ROOT / "geometry-core/panel_fill_support.inc")
+        self.assertIn("wood_panel_support_evaluate(&d->layout,rects,count,WORLD_MAX_TIMBERS,threshold,s)", support)
+        self.assertIn("malloc(WORLD_MAX_TIMBERS*sizeof *rects)", support)
+        for check in ("world", "timbers", "anchors", "contact", "cut_list", "span", "stop_face"):
+            self.assertIn("app_timber_capacity_" + check + "_check[", host)
+
+    def test_cut_list_ids_are_one_flat_array_not_one_array_per_group(self):
+        header = strip_comments(read(W / "cut_list.h"))
+        group, _, rest = header.partition("} WoodCutGroup;")
+        self.assertNotRegex(group, r"\bids\s*\[")
+        self.assertEqual(1, len(re.findall(r"\bids\s*\[", rest)))
+
+
+class NativeTimberCapacity(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        build = native()
+        source = build.woodworking / "timber-capacity-client.c"
+        shutil.copy2(HARNESS, source)
+        cls.client = build.compile(source, "timber-capacity-client")
+        cls.exe = build.link("timber-capacity-client", [cls.client, *build.product_objects()])
+        report = build.woodworking / "timber-capacity-report-client.c"
+        shutil.copy2(REPORT_HARNESS, report)
+        cls.report_client = build.compile(report, "timber-capacity-report-client")
+        cls.report_exe = build.link("timber-capacity-report", [cls.report_client, build.wood_cut_list_object, build.wood_boundary_policy_object])
+
+    def case(self, name, exe=None, marker=None):
+        result = subprocess.run([str(exe or self.exe), name], capture_output=True, text=True, encoding="utf-8", timeout=30)
+        self.assertEqual(1 if marker else 0, result.returncode, result.stderr)
+        self.assertEqual("ASSERT:" + marker + "\n" if marker else "", result.stderr)
+
+    def test_value_is_pinned_once_and_every_derived_bound_follows_it(self):
+        self.case("values")
+
+    def test_declaration_walks_the_real_capacity_slot_n_accepted_and_slot_n_plus_one_refused(self):
+        self.case("declaration")
+
+    def test_world_validation_refuses_more_members_than_the_contact_capacity_before_reading_any(self):
+        self.case("validation")
+
+    CONTROLS = (
+        ("declaration-refuses-last-slot", "member_declaration", "wood_member_declaration_object",
+         "if(*context->count==context->capacity){", "if(*context->count+1==context->capacity){",
+         "declaration", "declare-slot-accepted"),
+        ("declaration-never-refuses-at-capacity", "member_declaration", "wood_member_declaration_object",
+         "if(*context->count==context->capacity){", "if(*context->count>context->capacity){",
+         "declaration", "declare-over-capacity-refused"),
+        ("validation-guard-removed", "world_validation", "wood_world_validation_object",
+         '    if(context->member_count>WOOD_CONTACT_MEMBER_CAPACITY)\n'
+         '        return validation_refuse(error,capacity,"I33 CAPACITY: member count exceeds the contact capacity");\n',
+         "", "validation", "validation-over-capacity-fails-closed-before-reading"),
+        ("validation-guard-refuses-exact-capacity", "world_validation", "wood_world_validation_object",
+         "if(context->member_count>WOOD_CONTACT_MEMBER_CAPACITY)", "if(context->member_count>=WOOD_CONTACT_MEMBER_CAPACITY)",
+         "validation", "validation-exact-capacity-accepted"),
+    )
+
+    def changed_object(self, name, module, before, after):
+        build = native()
+        source = (build.woodworking / (module + ".c")).read_text(encoding="utf-8")
+        self.assertEqual(1, source.count(before), "Control must replace exactly one production expression: " + name)
+        path = build.woodworking / ("timber-capacity-" + name + ".c")
+        path.write_text(source.replace(before, after), encoding="utf-8")
+        return build.compile(path, "timber-capacity-" + name)
+
+    def test_boundary_guards_fail_their_named_assertions_and_restore(self):
+        build = native()
+        for name, module, attribute, before, after, case, marker in self.CONTROLS:
+            with self.subTest(control=name):
+                self.case(case)
+                changed = self.changed_object(name, module, before, after)
+                original = getattr(build, attribute)
+                objects = build.product_objects()
+                self.assertEqual(1, objects.count(original))
+                exe = build.link("timber-capacity-" + name, [self.client, *[changed if item == original else item for item in objects]])
+                self.case(case, exe, marker)
+                self.case(case)
+
+    def test_cut_list_guard_accepts_exactly_capacity_and_the_report_stays_linear(self):
+        build = native()
+        self.case("limits", self.report_exe)
+        changed = self.changed_object("cut-list-refuses-exact-capacity", "cut_list",
+                                      "count>WOOD_CUT_LIST_MEMBER_CAPACITY)return false;",
+                                      "count>=WOOD_CUT_LIST_MEMBER_CAPACITY)return false;")
+        exe = build.link("timber-capacity-cut-list-guard", [self.report_client, changed, build.wood_boundary_policy_object])
+        self.case("limits", exe, "report-capacity")
+        # A header control: padding each group by N ids brings the N-squared report back. It still
+        # compiles, so only the size assertion can notice.
+        directory = build.work / "timber-capacity-report-padding"
+        shutil.rmtree(directory, ignore_errors=True)
+        shutil.copytree(build.woodworking, directory)
+        header = directory / "cut_list.h"
+        text = header.read_text(encoding="utf-8")
+        before = "    size_t count,first;\n} WoodCutGroup;"
+        self.assertEqual(1, text.count(before))
+        header.write_text(text.replace(before, "    size_t count,first;\n    unsigned char reserved[WOOD_CUT_LIST_MEMBER_CAPACITY*4];\n} WoodCutGroup;"), encoding="utf-8")
+        client = directory / "report-client.c"
+        shutil.copy2(REPORT_HARNESS, client)
+        padded = build.link("timber-capacity-report-padded", [build.compile(client, "timber-capacity-padded-client"),
+            build.compile(directory / "cut_list.c", "timber-capacity-padded-cut-list"),
+            build.compile(directory / "boundary_policy.c", "timber-capacity-padded-boundary")])
+        self.case("limits", padded, "report-linear-size")
+        self.case("limits", self.report_exe)
+
+    def test_changing_the_value_fails_only_the_pin_because_every_other_bound_derives_from_it(self):
+        build = native()
+        directory = build.work / "timber-capacity-value-change"
+        shutil.rmtree(directory, ignore_errors=True)
+        shutil.copytree(build.woodworking, directory)
+        header = directory / "members.h"
+        text = header.read_text(encoding="utf-8")
+        before = "#define WOOD_MEMBER_CAPACITY %d" % CAPACITY
+        self.assertEqual(1, text.count(before))
+        header.write_text(text.replace(before, "#define WOOD_MEMBER_CAPACITY %d" % (CAPACITY * 2)), encoding="utf-8")
+        client = directory / "timber-capacity-value-client.c"
+        shutil.copy2(HARNESS, client)
+        # Only the "values" case runs: it calls nothing, so the original product objects are never entered.
+        exe = build.link("timber-capacity-value", [build.compile(client, "timber-capacity-value-client"), *build.product_objects()])
+        self.case("values", exe, "capacity-pinned-512")
+        self.case("values")
+
+
+class ProductTimberCapacity(unittest.TestCase):
+    HOST_CONTROLS = (
+        ("world-define-literal", "current_geometry.c", "#define WORLD_MAX_TIMBERS     WOOD_MEMBER_CAPACITY",
+         "#define WORLD_MAX_TIMBERS     64", "app_timber_capacity_world_check"),
+        ("storage-literal", "geometry-templates/woodworking/native/document.h", "WoodMember timbers[WOOD_MEMBER_CAPACITY];",
+         "WoodMember timbers[64];", "app_timber_capacity_timbers_check"),
+        ("contact-literal", "geometry-templates/woodworking/native/contact_world.h",
+         "#define WOOD_CONTACT_MEMBER_CAPACITY WOOD_MEMBER_CAPACITY", "#define WOOD_CONTACT_MEMBER_CAPACITY 64",
+         "app_timber_capacity_contact_check"),
+        ("cut-list-literal", "geometry-templates/woodworking/native/cut_list.h",
+         "#define WOOD_CUT_LIST_MEMBER_CAPACITY WOOD_MEMBER_CAPACITY", "#define WOOD_CUT_LIST_MEMBER_CAPACITY 64",
+         "app_timber_capacity_cut_list_check"),
+        ("span-literal", "geometry-templates/woodworking/native/member_reference.h",
+         "#define WOOD_MEMBER_SPAN_MEMBER_CAPACITY WOOD_MEMBER_CAPACITY", "#define WOOD_MEMBER_SPAN_MEMBER_CAPACITY 64",
+         "app_timber_capacity_span_check"),
+    )
+
+    def declare(self, bridge, identifier, size_a=27, size_b=33, role="primary"):
+        response = bridge.command("line timber %d %d %d role %s" % (identifier, size_a, size_b, role))
+        if "preview" in response and response["preview"].get("valid"):
+            response = bridge.command("line confirm %d" % response["preview"]["token"])
+        return response
+
+    def walk(self, exe, attempts):
+        """Declare unplaced timbers one by one until one is refused; report what the World kept."""
+        outcome = {"refused": None, "error": "", "world_kept": None}
+        with _bridge.BridgeSession(exe) as bridge:
+            self.assertTrue(bridge.command("reset")["ok"])
+            before = None
+            for index in range(attempts):
+                if index == CAPACITY:
+                    before = bridge.command("dump")["text"]
+                response = self.declare(bridge, 1000 + index)
+                if not response.get("ok"):
+                    outcome["refused"], outcome["error"] = index, str(response.get("error", ""))
+                    break
+            final = bridge.command("dump")["text"]
+            outcome["world_kept"] = None if before is None else before == final
+            # `objects` lists only placed timbers; the DSL dump has one line per declared timber.
+            outcome["declared"] = len(re.findall(r"^timber \d+ ", final, re.M))
+            outcome["redeclare_ok"] = bool(self.declare(bridge, 1000, 40, 50, "secondary").get("ok"))
+        return outcome
+
+    def test_bridge_accepts_exactly_capacity_timbers_refuses_the_next_and_keeps_the_world(self):
+        outcome = self.walk(native().bridge(), CAPACITY + 1)
+        self.assertEqual(CAPACITY, outcome["refused"], "the %dth declaration (index %d) is the first refusal" % (CAPACITY + 1, CAPACITY))
+        self.assertIn(OVER_CAPACITY, outcome["error"])
+        self.assertTrue(outcome["world_kept"], "a refused declaration must leave the whole World unchanged")
+        self.assertEqual(CAPACITY, outcome["declared"])
+        self.assertTrue(outcome["redeclare_ok"], "redeclaring an existing id at full capacity is an update, not an append")
+
+    def test_host_wiring_control_moves_the_actual_bridge_boundary_by_one(self):
+        build = native()
+        self.assertEqual(CAPACITY, self.walk(build.bridge(), CAPACITY + 1)["refused"])
+        destination = build.work / "timber-capacity-host-wiring"
+        shutil.rmtree(destination, ignore_errors=True)
+        entry = copy_product_closure(ROOT / "geometry-web/web_bridge.c", destination)
+        host = destination / "current_geometry.c"
+        before = b"&world->wood.timber_count,WORLD_MAX_TIMBERS,"
+        data = host.read_bytes()
+        self.assertEqual(1, data.count(before), "Control must change the one capacity argument of apply_timber_line")
+        host.write_bytes(data.replace(before, b"&world->wood.timber_count,WORLD_MAX_TIMBERS-1,"))
+        exe = build.link("timber-capacity-wiring", [build.compile(entry, "timber-capacity-wiring", PRODUCT_DEFINES), *build.product_objects()])
+        changed = self.walk(exe, CAPACITY + 1)
+        self.assertEqual(CAPACITY - 1, changed["refused"], "the last slot must now be refused")
+        self.assertEqual(CAPACITY - 1, changed["declared"])
+        self.assertEqual(CAPACITY, self.walk(build.bridge(), CAPACITY + 1)["refused"])
+
+    def test_static_bindings_fail_the_build_naming_the_drifted_constant(self):
+        build = native()
+        build.cli()  # positive control: the unchanged closure builds
+        for name, relative, before, after, check in self.HOST_CONTROLS:
+            with self.subTest(control=name):
+                destination = build.work / ("timber-capacity-" + name)
+                shutil.rmtree(destination, ignore_errors=True)
+                entry = copy_product_closure(HOST, destination)
+                target = destination / relative
+                data = target.read_bytes()
+                self.assertEqual(1, data.count(before.encode("utf-8")), "Control must change exactly one site: " + name)
+                target.write_bytes(data.replace(before.encode("utf-8"), after.encode("utf-8")))
+                with self.assertRaises(AssertionError) as caught:
+                    build.compile(entry, "timber-capacity-" + name, PRODUCT_DEFINES)
+                text = str(caught.exception)
+                self.assertIn("Native compile/link failed", text)
+                # gcc names the array typedef; MSVC reports C2118 (negative subscript) without it.
+                self.assertTrue(check in text or "C2118" in text, text[-1500:])
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
