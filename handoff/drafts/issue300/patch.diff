diff --git a/tests/geo261_timber_capacity_harness.c b/tests/geo261_timber_capacity_harness.c
new file mode 100644
--- /dev/null
+++ b/tests/geo261_timber_capacity_harness.c
@@ -0,0 +1,84 @@
+/* GEO #300 timber capacity witnesses at the real production capacity.
+ * Every N / N+1 pair here is written with the production macros, never a
+ * literal 512: the pinned value lives in exactly one assertion ("values"). */
+#include "contact_world.h"
+#include "cut_list.h"
+#include "member_declaration.h"
+#include "member_reference.h"
+#include "world_validation.h"
+#include <stdio.h>
+#include <string.h>
+#define CHECK(tag,x) do{if(!(x)){fprintf(stderr,"ASSERT:%s\n",tag);return 1;}}while(0)
+
+/* The value is a decision (see the issue), so it is pinned once, here. Every
+ * other name must equal it or derive from it. */
+static int values(void)
+{
+    CHECK("capacity-pinned-512",WOOD_MEMBER_CAPACITY==512);
+    CHECK("capacity-contact-members-derived",WOOD_CONTACT_MEMBER_CAPACITY==WOOD_MEMBER_CAPACITY);
+    CHECK("capacity-cut-list-members-derived",WOOD_CUT_LIST_MEMBER_CAPACITY==WOOD_MEMBER_CAPACITY);
+    CHECK("capacity-span-members-derived",WOOD_MEMBER_SPAN_MEMBER_CAPACITY==WOOD_MEMBER_CAPACITY);
+    CHECK("capacity-contact-faces-derived",WOOD_CONTACT_FACE_CAPACITY==
+        WOOD_CONTACT_COMPONENT_CAPACITY*GEO_LOOP_MAX_VERTICES*(GEO_REGION_MAX_HOLES+1)+2*WOOD_MEMBER_CAPACITY);
+    CHECK("capacity-span-cuts-derived",WOOD_MEMBER_SPAN_CUT_CAPACITY==
+        8*GEO_LOOP_MAX_VERTICES*(GEO_REGION_MAX_HOLES+1)+2*WOOD_MEMBER_CAPACITY);
+    CHECK("capacity-face-bounds-agree",WOOD_CONTACT_FACE_CAPACITY==WOOD_MEMBER_SPAN_CUT_CAPACITY);
+    return 0;
+}
+
+/* The host asks wood_member_declaration_capacity before it declares anything. Walk the
+ * real capacity: slot N is accepted, the next new id is refused, redeclaring an existing
+ * id at capacity is still allowed, and a refusal writes nothing. */
+static int declaration(void)
+{
+    WoodMember members[WOOD_MEMBER_CAPACITY+1];size_t count=0;
+    WoodMemberDeclarationContext context={members,&count,WOOD_MEMBER_CAPACITY,NULL,NULL,NULL};
+    memset(members,0,sizeof members);
+    for(size_t i=0;i<WOOD_MEMBER_CAPACITY;++i){const char *error=NULL;
+        CHECK("declare-slot-accepted",wood_member_declaration_capacity(&context,true,(uint32_t)(1000+i),&error)&&!error);
+        CHECK("declare-slot-appended",wood_member_declare(&context,(uint32_t)(1000+i),27,33,WOOD_MEMBER_ROLE_PRIMARY,0,&error)&&count==i+1);
+    }
+    CHECK("declare-exact-capacity-reached",count==WOOD_MEMBER_CAPACITY);
+    WoodMember snapshot[WOOD_MEMBER_CAPACITY+1];memcpy(snapshot,members,sizeof snapshot);
+    const char *error=NULL;
+    CHECK("declare-over-capacity-refused",!wood_member_declaration_capacity(&context,true,99999,&error)&&error&&!strcmp(error,"角材的數量超過上限"));
+    error=NULL;
+    CHECK("declare-over-capacity-without-id-refused",!wood_member_declaration_capacity(&context,false,0,&error)&&error&&!strcmp(error,"角材的數量超過上限"));
+    error=NULL;
+    CHECK("declare-existing-at-capacity-allowed",wood_member_declaration_capacity(&context,true,1000,&error)&&
+        wood_member_declaration_capacity(&context,true,(uint32_t)(1000+WOOD_MEMBER_CAPACITY-1),&error)&&!error);
+    CHECK("declare-refusal-writes-nothing",count==WOOD_MEMBER_CAPACITY&&!memcmp(snapshot,members,sizeof snapshot));
+    return 0;
+}
+
+/* wood_world_validate_members keeps one axis fact per member in a fixed array. */
+typedef struct {WoodGridState grids;WoodMember members[WOOD_CONTACT_MEMBER_CAPACITY];size_t calls;} ValidationFixture;
+static ValidationFixture fixture;
+static bool member_at(void *user,size_t i,WoodWorldMemberFact *out)
+{
+    ValidationFixture *f=user;++f->calls;
+    if(i>=WOOD_CONTACT_MEMBER_CAPACITY)return false;
+    memset(out,0,sizeof *out);out->member=&f->members[i];out->placement_id=10;out->length_direction=GEO_DIRECTION_POS_U;return true;
+}
+static int validation(void)
+{
+    WoodWorldValidationContext c;char error[256]="sentinel";
+    memset(&c,0,sizeof c);memset(&fixture,0,sizeof fixture);
+    c.grids.state=&fixture.grids;c.grids.user=&fixture;c.user=&fixture;c.member_at=member_at;
+    c.member_count=WOOD_CONTACT_MEMBER_CAPACITY;
+    CHECK("validation-exact-capacity-accepted",wood_world_validate_members(&c,error,sizeof error)&&!strcmp(error,"sentinel")&&
+        fixture.calls>=WOOD_CONTACT_MEMBER_CAPACITY);
+    fixture.calls=0;c.member_count=WOOD_CONTACT_MEMBER_CAPACITY+1;
+    CHECK("validation-over-capacity-fails-closed-before-reading",!wood_world_validate_members(&c,error,sizeof error)&&
+        !strncmp(error,"I33 CAPACITY",12)&&fixture.calls==0);
+    return 0;
+}
+
+int main(int argc,char **argv)
+{
+    if(argc!=2)return 2;
+    if(!strcmp(argv[1],"values"))return values();
+    if(!strcmp(argv[1],"declaration"))return declaration();
+    if(!strcmp(argv[1],"validation"))return validation();
+    return 2;
+}
