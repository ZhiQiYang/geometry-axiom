 {WoodGridContext c=app_grid_context(world),before;if(g_subgrid_before){before=app_grid_context(g_subgrid_before);c.before=&before;}return wood_grid_world_valid(&c,err,cap);}
 
+/* D10b/I24 (GEO-314). H decides what a commit is (R56); W owns the one-axis rule; K stays
+ * neutral. The baseline is the I23 one: g_subgrid_before is the live World at the start of
+ * the command, or a retained candidate's before at confirm. A scene-file replay keeps a
+ * per-line baseline that is only a partial World, so D61 replacements (open, load, import,
+ * recover) and R46/I31 replays never compare. Undo/redo restore a snapshot and never get
+ * here. No baseline means there is no commit to compare with. */
+static bool grid_stagger_commit_valid(const World *candidate,char *err,size_t cap)
+{
+    if(!g_subgrid_before||g_parsing_scene_file)return true;
+    return wood_grid_stagger_commit_valid(&candidate->geo.grid_store,&g_subgrid_before->geo.grid_store,err,cap);
+}
