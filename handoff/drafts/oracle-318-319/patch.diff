+        parts += [(min(u, v), y0, max(u, v), y1) for y0, y1 in ys]
+    merged = []
+    for r_ in sorted(parts, key=lambda r_: (r_[1], r_[3], r_[0])):  # 相鄰碎塊裡 y 範圍相同的合成一個矩形(bridged 看的是整段空檔)
