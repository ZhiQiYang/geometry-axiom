+            CHECK("frozen-span-verdict-and-prefix", !strncmp(actual,expected,strlen(expected)) && strlen(actual) > strlen(expected));
+        } else {
+            CHECK("frozen-span-verdict-and-bytes", a == e && !memcmp(actual,expected,sizeof actual));
+        }
     }
     return 0;
 }
