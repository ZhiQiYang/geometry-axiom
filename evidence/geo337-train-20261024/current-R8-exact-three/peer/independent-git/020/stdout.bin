+/* Positioning edge of a footprint (D16/R18): pure geometry. The interval on the length axis comes from the
+ * footprint alone and never from how the member was placed (at-face, at or through give the same fixed
+ * segment for the same footprint); the dump keeps references and placement order (R4) but not the method.
+ * Only the outer loop counts: hole edges are column stop faces without extension semantics (I20/I21). */
+/* The positioning edge of a footprint: its interval on the length axis and its outline edge id ("e<i>",
+ * index into the outer loop of the role boundary). out_edge may be NULL; no output is written when no
+ * positioning edge is found. wood_contact_boundary_interval is the same without the id. */
+bool wood_contact_boundary_edge(const WoodBoundaryRegion *,bool,GeoCoord,GeoCoord,GeoCoord,GeoCoord,GeoCoord *,GeoCoord *,int *);
 bool wood_contact_boundary_interval(const WoodBoundaryRegion *,bool,GeoCoord,GeoCoord,GeoCoord,GeoCoord,GeoCoord *,GeoCoord *);
+/* True when the contact range [lo,hi] (on the owner's length axis) lies on the owner's extension part (I22:
+ * an extension side counts as priority 2 when used as a stop). Only a boundary member located by an outline
+ * edge has a fixed part and an extension part; every other owner returns false. */
 bool wood_contact_owner_extension(const WoodContactWorld *,const WoodMember *,GeoCoord,GeoCoord);
 bool wood_contact_end_faces(const WoodContactWorld *,const WoodMember *,bool,GeoCoord,GeoCoord,GeoCoord,GeoCoord,char *,size_t);
 /* The optional resolver runs at the original collection point, after span
diff --git a/geometry-templates/woodworking/native/contacts.c b/geometry-templates/woodworking/native/contacts.c
index 8a3e78c7..74e65bb1 100644
--- a/geometry-templates/woodworking/native/contacts.c
+++ b/geometry-templates/woodworking/native/contacts.c
@@ -1,8 +1,12 @@
 #include "contacts.h"
 #include <stdio.h>
 
+/* I22 (W): a non-boundary member must stay inside its locating edge. The refusal keeps the
+ * original wording as an exact prefix and then names the locating edge ("e<edge_index>" and its
+ * interval on the length axis) and each exceeded interval: the low end [span_lo,edge_lo] and/or
+ * the high end [edge_hi,span_hi], all in mm. Capacity, truncation and err==NULL behave as before. */
 bool wood_member_span_extension_check(
-    const WoodMember *self, bool has_edge,
+    const WoodMember *self, bool has_edge, int edge_index,
     GeoCoord span_lo, GeoCoord span_hi, GeoCoord edge_lo, GeoCoord edge_hi,
     char *err, size_t err_cap
 )
@@ -10,9 +14,21 @@ bool wood_member_span_extension_check(
     if (has_edge && self->role != WOOD_MEMBER_ROLE_BOUNDARY &&
         (span_lo < edge_lo || span_hi > edge_hi)) {
         if (err != NULL) {
+            char low_note[64] = "", high_note[64] = "";
+            if (edge_lo > span_lo) {
+                snprintf(low_note, sizeof low_note, "，低端超出 [%lld,%lld] mm",
+                         (long long)span_lo, (long long)edge_lo);
+            }
+            if (edge_hi < span_hi) {
+                snprintf(high_note, sizeof high_note, "，高端超出 [%lld,%lld] mm",
+                         (long long)edge_hi, (long long)span_hi);
+            }
             snprintf(err, err_cap,
                      "V_EXTENSION：非 boundary 角材（%u）的 "
-                     "footprint 超出定位邊範圍", (unsigned)self->id);
+                     "footprint 超出定位邊範圍"
+                     "——定位邊 e%d [%lld,%lld] mm%s%s",
+                     (unsigned)self->id, edge_index,
+                     (long long)edge_lo, (long long)edge_hi, low_note, high_note);
         }
         return false;
     }
diff --git a/geometry-templates/woodworking/native/contacts.h b/geometry-templates/woodworking/native/contacts.h
index 3c445289..081cb5b0 100644
--- a/geometry-templates/woodworking/native/contacts.h
+++ b/geometry-templates/woodworking/native/contacts.h
@@ -6,10 +6,15 @@
 #include "supports.h"
 
 /* self is the same non-null member supplied to the original placement check.
- * Acceptance leaves err unchanged; refusal preserves the existing wording,
- * truncation and optional err==NULL behavior. */
+ * Acceptance leaves err unchanged. Refusal keeps the original wording as an
+ * exact prefix and then names the locating edge ("e<edge_index>" plus its
+ * interval [edge_lo,edge_hi] on the length axis) and each exceeded interval,
+ * the low end [span_lo,edge_lo] and/or the high end [edge_hi,span_hi], in mm
+ * (I22 W). edge_index is the outline edge id that located the member and is
+ * only read when has_edge. Truncation and optional err==NULL behavior are
+ * unchanged. */
 bool wood_member_span_extension_check(
-    const WoodMember *self, bool has_edge,
+    const WoodMember *self, bool has_edge, int edge_index,
     GeoCoord span_lo, GeoCoord span_hi, GeoCoord edge_lo, GeoCoord edge_hi,
     char *err, size_t err_cap
 );
diff --git a/tests/evidence/geo299-316-combined-20261022/PROGRESS.md b/tests/evidence/geo299-316-combined-20261022/PROGRESS.md
new file mode 100644
index 00000000..31ba0cf9
--- /dev/null
+++ b/tests/evidence/geo299-316-combined-20261022/PROGRESS.md
@@ -0,0 +1,27 @@
+# #299＋#316 combined 雲端進度
+
+本分支獨立基於整合公開 E `4b665fae21ab63aaffb7d84f6a32d5a469ba1675`（#288 code F2），不帶 #323，也不疊 #314。工作樹 `/tmp/g261-next299316`，分支 `codex/geo299-316-combined-20261022`；沒有 merge 或 force push。
+
+## 唯一補丁來源與靜態移植
+
+使用 handoff `804afbb4c5fa38b6023087d6dcb150f40c5978e6` 的完整 `handoff/drafts/combined/rebased-546e2eb2/patch.diff`；原 SHA256 `422946025137ba719ef4e42da1a527ba5bc07bbf8e52b28e687392061074fef6`。沒有先後套用兩個 individual 補丁。已讀根 AGENTS／PRODUCT-VISION、HANDOFF 第0／2節與兩案 DESIGN／TESTS。
+
+原 `git apply --check` 真退出1，`--reject` 真退出1；已知衝突為 contact_world.c 一個hunk與test_geo261_wood_contact_world.py兩個hunk，完整指令／退出碼／stdout／stderr／rejected hunks都保留。manifest刻意不套舊稿，沒有覆寫F2四檔。
+
+手解後保留 F2 `ContactOrderIndex` 的 last／minimum／重複id最後排序與最早遮蓋、equal-order穩定與容量fallback；從index宣告到完整collect-stops原bytes逐字相同。Python保留`app_contact_facts`→prepare wrapper檢查、原prepare裡member身分斷言，以及`index->minimum[slot]<order`→`<=`的具名負控。host facts harness只更換一處#299診斷全文，F2 raw callback snapshots及所有時序／partial-output斷言均保留。current_geometry.c仍統一CRLF。
+
+#299新增定位邊e<i>、定位邊區間與實際低／高超出區間，保留原V_EXTENSION前綴與原裁決；#316移除三個無caller的H wrappers及僅被死wrapper呼叫的W footprint API。完整190個既有manifest C sources的唯讀盤點未發現額外caller；190是此次清單結果，不是新增數值門檻。新增的caller測試依實際manifest動態seed，保兩入口與relative／root／publicK include規則、探索全部conditional分支、缺檔fail closed；也要求退役W名稱零引用。
+
+刪除範圍只包含死footprint API專屬的9個collision checks、一個測試方法與3個控制項；詳見closure-review.md的逐項對照。活I11放置／H重驗／W最終重驗、M12／M13與新增M97／M98、W邊接觸／跨承載面／未放置、contact-stop／owner原pointer identity各有對應，不能把死API單元測試冒稱產品守衛。新雙承載面正例仍待實跑，不靠調低expected消產品紅燈。
+
+AST／diff靜態核驗通過：原78個mutant定義除M13說明外不變，只新增M89–M98（由AST得到此次88個，不寫死未來總數，M99+保留#314）；新增10個anchor均唯一。core場景AST166與expected相符，wood contact world原10減退役1為9，其他expected全保。這是靜態盤點，不是runtime通過。
+
+manifest仍為原F2 920個policy identifiers；只列`+wood_contact_boundary_edge`／`-wood_contact_footprint_collides`待機械重算，scan／report／receipt未動。未改公理層.md、決策佇列.md、閱讀器或BACKLOG。
+
+## 下一步與限制
+
+父agent僅放行兩套W診斷：`python3 -B tests/test_geo261_wood_contacts.py`與`python3 -B tests/test_geo261_wood_contact_world.py`。先固定公開P，再使用全新私有TMPDIR、保完整原child0／1／0文字streams與可選GEO299316_EXECUTION_LOG，atexit清理前封compiler inputs／buildlog／ELF／objects。可選logger只錄原subprocess結果，不改oracle；此階段尚未執行兩套。
+
+其餘compile／測試／架構scan／ledger／browser／bench均未啟動。待兩套全部收齊後分類紅燈；每個產品／測試修正仍須具名baseline0／mutant1／restored0，不能以編譯失敗／timeout假稱killed。完整帳本、架構四檔、三條原裁判、全native／六browser／受影響專項由後續最終SHA另驗，不能將本段靜態準備當完成驗收。
+
+最不確定處仍是草稿推導的p8／p8b診斷數值與新雙承載面正例的真動態行為；後續原工具將裁定，尚未聲稱全綠。沒有新增公理語意或數值門檻待代決。
