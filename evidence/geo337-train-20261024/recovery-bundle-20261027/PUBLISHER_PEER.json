    "scripts": {
      "alias_proof.py": "\"\"\"Small local Git alias-reachability proof; no actual publisher or network.\"\"\"\nimport hashlib\nimport importlib.util\nimport json\nimport os\nimport pathlib\nimport sys\n\nHERE = pathlib.Path(__file__).resolve().parent\nROOT = HERE / 'alias-fixture'\nassert not ROOT.exists()\nROOT.mkdir()\ncapfile = pathlib.Path('/workspace/geo261-environment/final-f-contact-checker-proof-tools/capture.py')\nspec = importlib.util.spec_from_file_location('capture', capfile)\ncap = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(cap)\nenv = {k: v for k, v in os.environ.items() if not k.startswith('GIT_')}\nenv.update(GIT_CONFIG_NOSYSTEM='1', GIT_CONFIG_GLOBAL='/dev/null', GIT_NO_LAZY_FETCH='1',\n           GIT_TERMINAL_PROMPT='0', PYTHONDONTWRITEBYTECODE='1',\n           GIT_AUTHOR_DATE='2026-10-27T00:00:00Z', GIT_COMMITTER_DATE='2026-10-27T00:00:00Z')\nrec = cap.Recorder(ROOT, env, 'synthetic-local-only')\ngd = ROOT / 'fixture.git'\nrec.run(['git', 'init', '--bare', '--quiet', str(gd)], cwd=ROOT, timeout=30)\ndef git(*args, data=None):\n    return rec.run(['git', '--no-lazy-fetch', '--git-dir=' + str(gd), '-c', 'user.name=Codex',\n                    '-c', 'user.email=codex@openai.com', *args], cwd=ROOT,\n                    data=data, timeout=30)[1]\ndef obj(b):\n    value = b.decode().strip()\n    assert len(value) == 40 and all(c in '0123456789abcdef' for c in value)\n    return value\nold_blob = obj(git('hash-object', '-w', '--stdin', data=b'tiny already published raw stream\\n'))\nbase_tree = obj(git('mktree', data=('100644 blob ' + old_blob + '\\told-card.bin\\n').encode()))\nbase = obj(git('commit-tree', base_tree, data=b'Synthetic base\\n'))\ngit('update-ref', 'refs/heads/fixed-parent', base, '0' * 40)\n(gd / 'shallow').write_text(base + '\\n')\nnew_blob = obj(git('hash-object', '-w', '--stdin', data=b'tiny new evidence\\n'))\nnew_tree = obj(git('mktree', data=(\n    '100644 blob ' + old_blob + '\\told-card.bin\\n' +\n    '100644 blob ' + old_blob + '\\tstdout-alias.bin\\n' +\n    '100644 blob ' + new_blob + '\\tnew-evidence.txt\\n').encode()))\nnew = obj(git('commit-tree', new_tree, '-p', base, data=b'Synthetic alias addition\\n'))\nraw = git('rev-list', '--objects', new, '^' + base)\noutgoing = [line.split(b' ', 1)[0].decode() for line in raw.splitlines()]\nassert old_blob not in outgoing\nnew_alias = obj(git('rev-parse', new + ':stdout-alias.bin'))\nstate = {'base': base, 'alias': old_blob, 'entries': {'new-evidence.txt': new_blob,\n         'stdout-alias.bin': old_blob}, 'created': [new_tree], 'new': new,\n         'outgoing': outgoing, 'new_alias': new_alias}\n(ROOT / 'OBSERVATION.json').write_text(json.dumps(state, indent=2) + '\\n')\ncases = []\nfor mode, expected in [('normal', 0), ('include_old_blob_mutant', 1), ('restored', 0)]:\n    row, stdout, _ = rec.run([sys.executable, '-B', str(HERE/'alias_gate.py'), mode],\n                             cwd=ROOT, timeout=30, check=False, source_variant=mode)\n    assert row['actual_process_returncode'] == expected\n    cases.append(json.loads(stdout))\nrecorded = []\nfor row in rec.rows:\n    r = dict(row)\n    for label in ['stdin', 'stdout', 'stderr']:\n        b = (pathlib.Path(row['directory']) / (label+'.bin')).read_bytes()\n        assert hashlib.sha256(b).hexdigest() == row[label+'_sha256']\n        r[label+'_utf8'] = b.decode()\n    recorded.append(r)\nresult = {'exit_code': 0, 'scope': 'Synthetic tiny local bare repository, no remote or actual publisher; tiny stdin is fixture setup only, production argv constraint unchanged',\n          'source_formula': 'expected=set(entries.values())-{ALIAS_OID}|created|{new}',\n          'environment_overrides': {k:v for k,v in env.items() if k.startswith('GIT_')},\n          'observation': state, 'gate_exits': [x['exit_code'] for x in cases], 'cases': cases,\n          'full_original_commands_and_streams': recorded,\n          'script_sha256': {name:hashlib.sha256((HERE/name).read_bytes()).hexdigest()\n                            for name in ['alias_proof.py','alias_gate.py']}}\n(ROOT / 'RESULT.json').write_text(json.dumps(result, indent=2) + '\\n')\nprint(json.dumps({'exit_code':0,'gate_exits':result['gate_exits'],'recorded_commands':len(recorded),\n                  'result_sha256':hashlib.sha256((ROOT/'RESULT.json').read_bytes()).hexdigest()}))\n",
      "alias_gate.py": "import json\nimport pathlib\nimport sys\n\nroot = pathlib.Path(__file__).resolve().parent / 'alias-fixture'\nstate = json.loads((root / 'OBSERVATION.json').read_text())\nmode = sys.argv[1]\nassert mode in {'normal', 'include_old_blob_mutant', 'restored'}\nexpected = set(state['entries'].values()) | set(state['created']) | {state['new']}\nif mode != 'include_old_blob_mutant':\n    expected -= {state['alias']}\nactual = set(state['outgoing'])\nok = actual == expected and state['alias'] not in actual and state['new_alias'] == state['alias']\nprint(json.dumps({'mode': mode, 'exit_code': 0 if ok else 1, 'expected': sorted(expected),\n                  'actual': sorted(actual), 'alias': state['alias'], 'new_alias': state['new_alias']}))\nsys.exit(0 if ok else 1)\n"
