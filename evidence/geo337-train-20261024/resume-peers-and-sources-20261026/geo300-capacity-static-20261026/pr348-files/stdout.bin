[{"sha":"86778303ac98eea4a3ecb1e1d61cf85ee543e5a5","filename":"current_geometry.c","status":"modified","additions":10,"deletions":1,"changes":11,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/current_geometry.c","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/current_geometry.c","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/current_geometry.c?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f","patch":"@@ -2738,7 +2738,7 @@ static bool path_beside_source(char *buffer, size_t size, const char *name)\n #define WORLD_MAX_PLACEMENTS  16\r\n #define WORLD_MAX_GUIDES      16\r\n #define WORLD_MAX_GRIDS       16\r\n-#define WORLD_MAX_TIMBERS     64\r\n+#define WORLD_MAX_TIMBERS     WOOD_MEMBER_CAPACITY\r\n #define WORLD_MAX_SPACES      GEO_ENCLOSURE_CAPACITY\r\n #define WORLD_MAX_RC          32\r\n #define WORLD_MAX_CANVAS_POS  (WORLD_MAX_BOUNDARIES + WORLD_MAX_PLACEMENTS + WORLD_MAX_SPACES + WORLD_MAX_RC * 2 + WORLD_MAX_GRID_SYSTEMS + WORLD_MAX_GRID_BINDINGS + PARAM_CARD_MAX)\r\n@@ -6039,6 +6039,15 @@ typedef GeoInterval SpanInterval;\n typedef char app_span_status_abi_check[(int)SPAN_BETWEEN_AMBIGUOUS==(int)WOOD_SPAN_BETWEEN_AMBIGUOUS?1:-1];\r\n typedef char app_span_scratch_bound_check[SPAN_CUT_MAX==WOOD_MEMBER_SPAN_CUT_CAPACITY?1:-1];\r\n \r\n+/* Bind the host admission bound to real W storage and scratch. */\r\n+typedef char app_timber_capacity_world_check[WORLD_MAX_TIMBERS==WOOD_MEMBER_CAPACITY?1:-1];\r\n+typedef char app_timber_capacity_timbers_check[sizeof(((World *)0)->wood.timbers)/sizeof(((World *)0)->wood.timbers[0])==WORLD_MAX_TIMBERS?1:-1];\r\n+typedef char app_timber_capacity_anchors_check[sizeof(((World *)0)->wood.anchors)/sizeof(((World *)0)->wood.anchors[0])==WORLD_MAX_TIMBERS?1:-1];\r\n+typedef char app_timber_capacity_contact_check[WOOD_CONTACT_MEMBER_CAPACITY>=WORLD_MAX_TIMBERS?1:-1];\r\n+typedef char app_timber_capacity_cut_list_check[WOOD_CUT_LIST_MEMBER_CAPACITY>=WORLD_MAX_TIMBERS?1:-1];\r\n+typedef char app_timber_capacity_span_check[WOOD_MEMBER_SPAN_MEMBER_CAPACITY>=WORLD_MAX_TIMBERS?1:-1];\r\n+typedef char app_timber_capacity_stop_face_check[STOP_FACE_MAX==WOOD_CONTACT_FACE_CAPACITY?1:-1];\r\n+\r\n /*\r\n  * 解析 auto 跨距。\r\n  *\r"},{"sha":"cfc24d0260613bf0066348dbc54c5d07a666bc58","filename":"evidence/geo300-capacity512-20261024/PROGRESS.md","status":"added","additions":11,"deletions":0,"changes":11,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2FPROGRESS.md","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2FPROGRESS.md","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2FPROGRESS.md?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f","patch":"@@ -0,0 +1,11 @@\n+# #348 容量 512：同來源定向修正已驗，完整放置仍紅\n+\n+目前來源為 `73b21e64dce72f0d16ca29e18559c51815b9724d`，產品 C 仍為 `400a6d0ca50f3aca104fb569c77c8ef753c93355`。這次修正安全哨兵的測試前置，沒有改產品容量規則。\n+\n+F73 的三個受影響 H 方法全部通過，三組 helper 與哨兵測試修正各有真正 0／1／0。原 first batch 整批 exit 1 保留：它的前十個 phase 符合預期，最後三個被原 100 MiB 空間守門標為未跑；同 F 的獨立 resume 只補這三個，exit 0。兩批來源最後皆 clean。\n+\n+歷史 F0f 完整 W7 全綠；H7 的三個哨兵 assertion 已由 F73 定向修正驗證。兩個真實 512 放置／重放方法的原 600 秒 timeout 仍未解，本輪沒有重跑，也沒有調整時限。完整 native／六 browser／帳本／架構及容量性能仍未完成，非 READY-TO-MERGE。\n+\n+完整原件已封存、原 byte roundtrip 完成：F0f 紅包 6369 member，獨審 25485/0＋原流分類 1809/0；F73 定向包 5901 member，獨審 23643/0，另有原斷言／phase 獨審 171/0。F0f 的四份 scene 為執行中事後保全；F73 v2 observer 為呼叫前保全，兩者沒有混稱。六個刻意建立的 symlink/FIFO 自驗 fixture 僅保存 lstat／readlink 描述，沒有循連結或讀 FIFO。\n+\n+下一步先把兩包與本進度一般 push 到本線證據目錄，再更新既有 #348 正文；不另開重複 PR。主代理正在優先修正 #338 的效能紅燈，本線依主代理指派一般 merge 完成驗收的新列車後，再診斷兩個 512 timeout；不先重跑未修的 600 秒項目。既有完整原件原位保留，出版沿獨立驗證的 Git 物件儲存與一般 push；這項環境安排不改正式 100 MiB 守門或產品時限。"},{"sha":"12d50d99b7dfd9908168474e1804a28a2314d4ba","filename":"evidence/geo300-capacity512-20261024/QUESTIONS.md","status":"added","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2FQUESTIONS.md","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2FQUESTIONS.md","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2FQUESTIONS.md?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f","patch":"@@ -0,0 +1,3 @@\n+# Capacity 512 questions\n+\n+本片沒有新增待拍板的公理、鎖定決策或時間門檻。512 個已放置成員與完整 UI／幾何行為仍待正式驗收；未放置 fixture 不取代它。若驗收發現需要新門檻或公理語意，另列選項，先做不受影響部分。"},{"sha":"ba774e2e87a11531f3412174caf04b31a6cee383","filename":"evidence/geo300-capacity512-20261024/RAW_INDEX.json","status":"added","additions":3478,"deletions":0,"changes":3478,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2FRAW_INDEX.json","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2FRAW_INDEX.json","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2FRAW_INDEX.json?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f"},{"sha":"2867dd54f2a764bbd1802a71aa7de223aa7df5c4","filename":"evidence/geo300-capacity512-20261024/SUMMARY.json","status":"added","additions":33,"deletions":0,"changes":33,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2FSUMMARY.json","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2FSUMMARY.json","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2FSUMMARY.json?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f","patch":"@@ -0,0 +1,33 @@\n+{\n+  \"product_sha\": \"400a6d0ca50f3aca104fb569c77c8ef753c93355\",\n+  \"archive\": \"original-capacity512-drafts-and-static-reviews.tar.gz\",\n+  \"archive_bytes\": 751021,\n+  \"archive_sha256\": \"0b6ea82d93952e40dc199483828c3e595401720f4e36da755022e9e8fe016542\",\n+  \"member_count\": 578,\n+  \"scope\": \"Static source preparation and peer originals only. No compiler, suite, bridge, ledger or architecture execution.\",\n+  \"base_sha\": \"6d9d46e8d16af75351924c6d47a078d3eb647cc0\",\n+  \"merged_346_evidence\": \"eaf15e239324a6464a04740647afccce3a3c17c7\",\n+  \"ordinary_merge_sha\": \"696f7f07846c6224775dab5736bd1dc45541a4bf\",\n+  \"source_leaves\": 15,\n+  \"product_leaves\": 7,\n+  \"companion_leaves\": 6,\n+  \"registry_leaves\": 2,\n+  \"old_panel_count\": 13,\n+  \"old_report_count\": 11,\n+  \"new_methods_ast_only\": {\n+    \"W\": 7,\n+    \"H\": 5\n+  },\n+  \"static_peers\": {\n+    \"product_plan\": \"12/0\",\n+    \"W_companion\": \"39/0\",\n+    \"H_and_registry_v2\": \"60/0\",\n+    \"applied_source\": \"73/0\"\n+  },\n+  \"runtime\": \"UNRUN\",\n+  \"compile\": \"UNRUN\",\n+  \"mutation_proofs\": \"UNRUN\",\n+  \"ledger\": \"UNRUN; main agent only\",\n+  \"architecture\": \"UNRUN\",\n+  \"created_utc\": \"2026-10-24T01:23:49.401181+00:00\"\n+}"},{"sha":"b0c510277743c2b912e7d6ab6bf48b2950f3d423","filename":"evidence/geo300-capacity512-20261024/body/PR_BODY.template.before-assertion-wording.md","status":"added","additions":28,"deletions":0,"changes":28,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fbody%2FPR_BODY.template.before-assertion-wording.md","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fbody%2FPR_BODY.template.before-assertion-wording.md","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2Fbody%2FPR_BODY.template.before-assertion-wording.md?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f","patch":"@@ -0,0 +1,28 @@\n+把既有角材上限從 64 擴至 512，將 W 的單一容量常數連到 H admission、真 document arrays、contact、cut-list 與 span scratch，並在 world validation 的 callback 前拒絕超容量輸入。新增具名編譯契約，避免 H／W 不同容量造成陣列或 scratch 不一致。其他邊界、placement、obstacle 等容量保留。\n+\n+本片疊在 #128 P2，已正常 merge #346 的正式證據，順序為 #343 → #346 → P2 → 本 PR。它是 #300 的容量草稿，還沒有正式 C 或 browser 驗收，不關閉 #300。\n+\n+## 唯一 current-state\n+\n+| 欄位／gate | 目前值或退出碼 | 精確界線 |\n+|---|---|---|\n+| product SHA | `400a6d0ca50f3aca104fb569c77c8ef753c93355` | 七產品 leaf、六測試 leaf、兩 registry leaf |\n+| evidence head | `EVIDENCE_HEAD_PLACEHOLDER` | 只加入靜態準備原件與 UNRUN 進度 |\n+| base／普通 merge | P2 `6d9d46e8d16af75351924c6d47a078d3eb647cc0`；merge `696f7f07846c6224775dab5736bd1dc45541a4bf` | 第二 parent 為 #346 E `eaf15e239324a6464a04740647afccce3a3c17c7` |\n+| apply／diff check／一般 push | **0** | 公開 source 的 15 leaves 與已審草稿逐 bytes 相同；H 保留 CRLF |\n+| 獨立靜審 | **12/0、39/0、60/0、73/0、1780/0** | 計畫、W、H/registry v2、實際套用、公開 source/原件包；非 C 執行 |\n+| 新 W／H suites | **UNRUN** | AST 7／5 方法，尚未 runtime discovery 或編譯 |\n+| 新撤回／恢復與七 ABI 控制 | **UNRUN** | 只準備測試，不宣稱 killed 或正常執行 |\n+| 舊 contact／report／panel suites | **UNRUN at this S** | 保留原 64 witnesses、panel=13、report=11；不挪用舊 SHA 的綠燈 |\n+| 完整 native／六 browser／專項／效能 | **UNRUN** | 沒有新增時間門檻，也未聲稱擴容後效能通過 |\n+| 最終帳本／架構三裁判與四檔收據 | **UNRUN** | 主代理依最後來源統一處理；未改 tests/mutate.py 或重產帳本 |\n+| 允許 skip | 沒有新增 | 目前沒有正式執行，不能宣稱 0 skip |\n+| 合併狀態 | **NOT READY** | 正式 C 時槽尚未授權，所有 runtime gate 待跑 |\n+\n+測試把原 64、真 512 與真 513 邊界分開。W 包含報表 ID 池／按值 copy、contact 穩定排序與 fallback、validation callback 邊界與宣告容量。H 使用真 bridge／World，準備 512 宣告、513 原子拒絕、既有 ID 更新、undo／redo／dump/load byte identity。512 validation 正例及 bridge 宣告是未放置成員，不能替代 512 個已放置角材的幾何、施工或 UI 驗收。\n+\n+撤 guard 的負例避免越界：宣告只呼叫 direct API；H 只送缺 ID sentinel，必須在 append 前語法拒絕，不將有效第 513 成員送入已撤保護的固定陣列。七 ABI 負例只預期具名 typedef 編譯拒絕，再恢復原值重新編譯；不執行混用容量的 ABI 物件。所有正式反證目前均未跑。\n+\n+`evidence/geo300-capacity512-20261024/RAW_INDEX.json` 保存 578 個原件的 path／bytes／SHA-256，archive `original-capacity512-drafts-and-static-reviews.tar.gz` 為 751,021 bytes，SHA-256 `0b6ea82d93952e40dc199483828c3e595401720f4e36da755022e9e8fe016542`。公開 source 的原 Git 命令、退出碼與 15 個 blobs 已保留；原 H v1、registry 排序修正前稿及 peer matcher 初錯誤也保留，皆與產品執行分開。\n+\n+未改公理、決策佇列、K、斷言、golden 或原時限。最不確定的是尚未執行的 512 真 bridge／compiler／完整放置與效能結果；下一步在固定公開來源跑受影響的原裁判與新測試，依實際紅燈修正，最後統一重產帳本與架構。"},{"sha":"cff8857db31e3c24986438af75575ed37eabcdb6","filename":"evidence/geo300-capacity512-20261024/body/PR_BODY.template.md","status":"added","additions":28,"deletions":0,"changes":28,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fbody%2FPR_BODY.template.md","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fbody%2FPR_BODY.template.md","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2Fbody%2FPR_BODY.template.md?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f","patch":"@@ -0,0 +1,28 @@\n+把既有角材上限從 64 擴至 512，將 W 的單一容量常數連到 H admission、真 document arrays、contact、cut-list 與 span scratch，並在 world validation 的 callback 前拒絕超容量輸入。新增具名編譯契約，避免 H／W 不同容量造成陣列或 scratch 不一致。其他邊界、placement、obstacle 等容量保留。\n+\n+本片疊在 #128 P2，已正常 merge #346 的正式證據，順序為 #343 → #346 → P2 → 本 PR。它是 #300 的容量草稿，還沒有正式 C 或 browser 驗收，不關閉 #300。\n+\n+## 唯一 current-state\n+\n+| 欄位／gate | 目前值或退出碼 | 精確界線 |\n+|---|---|---|\n+| product SHA | `400a6d0ca50f3aca104fb569c77c8ef753c93355` | 七產品 leaf、六測試 leaf、兩 registry leaf |\n+| evidence head | `EVIDENCE_HEAD_PLACEHOLDER` | 只加入靜態準備原件與 UNRUN 進度 |\n+| base／普通 merge | P2 `6d9d46e8d16af75351924c6d47a078d3eb647cc0`；merge `696f7f07846c6224775dab5736bd1dc45541a4bf` | 第二 parent 為 #346 E `eaf15e239324a6464a04740647afccce3a3c17c7` |\n+| apply／diff check／一般 push | **0** | 公開 source 的 15 leaves 與已審草稿逐 bytes 相同；H 保留 CRLF |\n+| 獨立靜審 | **12/0、39/0、60/0、73/0、1780/0** | 計畫、W、H/registry v2、實際套用、公開 source/原件包；非 C 執行 |\n+| 新 W／H suites | **UNRUN** | AST 7／5 方法，尚未 runtime discovery 或編譯 |\n+| 新撤回／恢復與七 ABI 控制 | **UNRUN** | 只準備測試，不宣稱 killed 或正常執行 |\n+| 舊 contact／report／panel suites | **UNRUN at this S** | 保留原 64 witnesses、panel=13、report=11；不挪用舊 SHA 的綠燈 |\n+| 完整 native／六 browser／專項／效能 | **UNRUN** | 沒有新增時間門檻，也未聲稱擴容後效能通過 |\n+| 最終帳本／架構三裁判與四檔收據 | **UNRUN** | 主代理依最後來源統一處理；未改 tests/mutate.py 或重產帳本 |\n+| 允許 skip | 沒有新增 | 目前沒有正式執行，不能宣稱 0 skip |\n+| 合併狀態 | **NOT READY** | 正式 C 時槽尚未授權，所有 runtime gate 待跑 |\n+\n+測試把原 64、真 512 與真 513 邊界分開。W 包含報表 ID 池／按值 copy、contact 穩定排序與 fallback、validation callback 邊界與宣告容量。H 使用真 bridge／World，準備 512 宣告、513 原子拒絕、既有 ID 更新、undo／redo／dump/load byte identity。512 validation 正例及 bridge 宣告是未放置成員，不能替代 512 個已放置角材的幾何、施工或 UI 驗收。\n+\n+撤 guard 的負例避免越界：宣告只呼叫 direct API；H 只送缺 ID sentinel，必須在 append 前語法拒絕，不將有效第 513 成員送入已撤保護的固定陣列。七 ABI 負例只預期具名 typedef 編譯拒絕，再恢復原值重新編譯；不執行混用容量的 ABI 物件。所有正式反證目前均未跑。\n+\n+`evidence/geo300-capacity512-20261024/RAW_INDEX.json` 保存 578 個原件的 path／bytes／SHA-256，archive `original-capacity512-drafts-and-static-reviews.tar.gz` 為 751,021 bytes，SHA-256 `0b6ea82d93952e40dc199483828c3e595401720f4e36da755022e9e8fe016542`。公開 source 的原 Git 命令、退出碼與 15 個 blobs 已保留；原 H v1、registry 排序修正前稿及 peer matcher 初錯誤也保留，皆與產品執行分開。\n+\n+未改公理、決策佇列或 K。既有 64 witnesses 保留；容量契約斷言依授權同步至 512／513 與 3328，其他 golden／原時限不放寬。最不確定的是尚未執行的 512 真 bridge／compiler／完整放置與效能結果；下一步在固定公開來源跑受影響的原裁判與新測試，依實際紅燈修正，最後統一重產帳本與架構。"},{"sha":"cfc24d0260613bf0066348dbc54c5d07a666bc58","filename":"evidence/geo300-capacity512-20261024/formal-F73b21e64/PROGRESS.md","status":"added","additions":11,"deletions":0,"changes":11,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2FPROGRESS.md","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2FPROGRESS.md","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2FPROGRESS.md?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f","patch":"@@ -0,0 +1,11 @@\n+# #348 容量 512：同來源定向修正已驗，完整放置仍紅\n+\n+目前來源為 `73b21e64dce72f0d16ca29e18559c51815b9724d`，產品 C 仍為 `400a6d0ca50f3aca104fb569c77c8ef753c93355`。這次修正安全哨兵的測試前置，沒有改產品容量規則。\n+\n+F73 的三個受影響 H 方法全部通過，三組 helper 與哨兵測試修正各有真正 0／1／0。原 first batch 整批 exit 1 保留：它的前十個 phase 符合預期，最後三個被原 100 MiB 空間守門標為未跑；同 F 的獨立 resume 只補這三個，exit 0。兩批來源最後皆 clean。\n+\n+歷史 F0f 完整 W7 全綠；H7 的三個哨兵 assertion 已由 F73 定向修正驗證。兩個真實 512 放置／重放方法的原 600 秒 timeout 仍未解，本輪沒有重跑，也沒有調整時限。完整 native／六 browser／帳本／架構及容量性能仍未完成，非 READY-TO-MERGE。\n+\n+完整原件已封存、原 byte roundtrip 完成：F0f 紅包 6369 member，獨審 25485/0＋原流分類 1809/0；F73 定向包 5901 member，獨審 23643/0，另有原斷言／phase 獨審 171/0。F0f 的四份 scene 為執行中事後保全；F73 v2 observer 為呼叫前保全，兩者沒有混稱。六個刻意建立的 symlink/FIFO 自驗 fixture 僅保存 lstat／readlink 描述，沒有循連結或讀 FIFO。\n+\n+下一步先把兩包與本進度一般 push 到本線證據目錄，再更新既有 #348 正文；不另開重複 PR。主代理正在優先修正 #338 的效能紅燈，本線依主代理指派一般 merge 完成驗收的新列車後，再診斷兩個 512 timeout；不先重跑未修的 600 秒項目。既有完整原件原位保留，出版沿獨立驗證的 Git 物件儲存與一般 push；這項環境安排不改正式 100 MiB 守門或產品時限。"},{"sha":"eb05b20410e37e16658d442d5742f01b4431b39a","filename":"evidence/geo300-capacity512-20261024/formal-F73b21e64/PUBLICATION_MANIFEST.json","status":"added","additions":2028,"deletions":0,"changes":2028,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2FPUBLICATION_MANIFEST.json","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2FPUBLICATION_MANIFEST.json","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2FPUBLICATION_MANIFEST.json?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f"},{"sha":"93691a06bda19c979b6b58801a6594f9df619f85","filename":"evidence/geo300-capacity512-20261024/formal-F73b21e64/bind_completed_preload.py","status":"added","additions":36,"deletions":0,"changes":36,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fbind_completed_preload.py","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fbind_completed_preload.py","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fbind_completed_preload.py?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f","patch":"@@ -0,0 +1,36 @@\n+\"\"\"Bind completed preload receipts and already-reviewed documents; no Git writes.\"\"\"\n+from pathlib import Path\n+import hashlib,json\n+P=Path(__file__).resolve().parent;B=Path('/tmp/geo348-original-archives-preload-20261024')\n+PREFIX='evidence/geo300-capacity512-20261024/formal-F73b21e64/'\n+def h(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()\n+m=json.loads((P/'FILE_ALLOWLIST_UNBOUND.json').read_bytes());completed=json.loads((B/'RESULT.json').read_bytes())\n+assert completed['exit']==0 and completed['parent_environment_unchanged']\n+assert json.loads((B/'EXEC_COMPLETION.json').read_bytes())['exit_code']==0\n+def add(p,rel):\n+ p=Path(p);assert p.is_file()and not p.is_symlink();m['files'].append({'local':str(p),'relative':PREFIX+rel,'bytes':p.stat().st_size,'sha256':h(p),'archive_preload_required':False})\n+for p in sorted(B.rglob('*')):\n+ if p.is_file():add(p,'storage-preload/'+p.relative_to(B).as_posix())\n+add(P/'preload_archives.py','storage-preload/preload_archives.py')\n+add(P/'prepare_file_allowlist.py','prepare_file_allowlist.py')\n+add(Path(__file__),'bind_completed_preload.py')\n+add('/workspace/geo348-F73-publication-doc-peer-specials-20261024/REVIEW.json','independent-peers/F73/CURRENT_DOC_REVIEW.json')\n+doc=json.loads(Path('/workspace/geo348-F73-publication-doc-peer-specials-20261024/REVIEW.json').read_bytes())\n+assert doc['failed']==0 and doc['body_sha256']==h(P/'PR_BODY.template.md') and doc['progress_sha256']==h(P/'PROGRESS.md')\n+preloads={}\n+for phase in completed['phases']:\n+ r=json.loads(Path(phase['tool_result']).read_bytes());assert phase['actual_exit']==r['exit_code']==0 and r['before']==r['after'] and r['global_git_environment_unchanged']\n+ a=r['archive_identity'];matches=[x for x in m['files']if x['archive_preload_required']and x['sha256']==a['sha256']and x['bytes']==a['bytes']];assert len(matches)==1\n+ preloads[matches[0]['relative']]={'oid':r['object_oid'],'bytes':a['bytes'],'sha256':a['sha256'],'receipt':phase['tool_result']}\n+assert len(preloads)==2\n+m.update(status='READY: original archive preloads completed; final publisher still requires fresh guards',\n+ preloaded_archives=preloads,permanent_store_lease={'path':'/tmp/geo337-published-archive-git-objects-20261024/info/CODEX_PERMANENT_OBJECTS.json','sha256':'556c513142d9559c9497bb118d12da5487ee61b80953ee27095e49269d7c0104'},\n+ root_alternates={'path':'/workspace/geometry-axiom/.git/objects/info/alternates','sha256':'e4003887d478e946abfb1c76daa861b688d1c37d936f510a73fd833fbf48b7be'})\n+m['payload_bytes']=sum(x['bytes']for x in m['files']);m['nonarchive_bytes']=sum(x['bytes']for x in m['files']if not x['archive_preload_required'])\n+m['publication_min_free_bytes']=2*m['nonarchive_bytes']+16*1024*1024\n+m['publication_budget_basis']='Two full nonarchive payload allowances plus16MiB for owned index/tree/raw metadata. Archive26,458,248B already resides in permanent TMP Git store; each ordinary writer must prove no primary duplicate. This is a publication resource estimate, not a measured peak or product threshold.'\n+assert len({x['relative']for x in m['files']})==len(m['files'])\n+target=P/'READY_MANIFEST.json';assert not target.exists();target.write_text(json.dumps(m,ensure_ascii=False,indent=2)+'\\n')\n+s=(P/'publish_draft.py').read_text();old=\"READY_MANIFEST_SHA256='UNBOUND_DO_NOT_EXECUTE'\";assert s.count(old)==1\n+bound=P/'publish_bound.py';assert not bound.exists();bound.write_text(s.replace(old,\"READY_MANIFEST_SHA256='\"+h(target)+\"'\"))\n+print(json.dumps({'manifest':str(target),'manifest_sha256':h(target),'publisher':str(bound),'publisher_sha256':h(bound),'payload_bytes':m['payload_bytes'],'nonarchive_bytes':m['nonarchive_bytes'],'publication_min_free_bytes':m['publication_min_free_bytes'],'files':len(m['files']),'runtime':'UNRUN'},ensure_ascii=False))"},{"sha":"d854495e4589d9f20ff9a72aeec0690036eea46c","filename":"evidence/geo300-capacity512-20261024/formal-F73b21e64/historical-F0f/ORIGINAL_W7_H7_AND_HELPER_TRIPLES.tar.gz","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fhistorical-F0f%2FORIGINAL_W7_H7_AND_HELPER_TRIPLES.tar.gz","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fhistorical-F0f%2FORIGINAL_W7_H7_AND_HELPER_TRIPLES.tar.gz","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fhistorical-F0f%2FORIGINAL_W7_H7_AND_HELPER_TRIPLES.tar.gz?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f"},{"sha":"3b54ef70e9d1dd1d175f39f702e3321b70cea09d","filename":"evidence/geo300-capacity512-20261024/formal-F73b21e64/historical-F0f/RAW_INDEX.json","status":"added","additions":38223,"deletions":0,"changes":38223,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fhistorical-F0f%2FRAW_INDEX.json","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fhistorical-F0f%2FRAW_INDEX.json","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fhistorical-F0f%2FRAW_INDEX.json?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f"},{"sha":"a94c40930ed4558babdc764fe5cbd1f9f1531bba","filename":"evidence/geo300-capacity512-20261024/formal-F73b21e64/historical-F0f/SUMMARY.json","status":"added","additions":110,"deletions":0,"changes":110,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fhistorical-F0f%2FSUMMARY.json","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fhistorical-F0f%2FSUMMARY.json","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fhistorical-F0f%2FSUMMARY.json?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f","patch":"@@ -0,0 +1,110 @@\n+{\n+  \"source_sha\": \"0f695866c0ba12d2c70dfd7d40628d0fda0f905f\",\n+  \"archive\": \"ORIGINAL_W7_H7_AND_HELPER_TRIPLES.tar.gz\",\n+  \"archive_bytes\": 12616070,\n+  \"archive_sha256\": \"dbe988b880024aee708d85d3b0364adf5ab61c9587f861271d8e2170755b37a7\",\n+  \"member_count\": 6369,\n+  \"original_exit\": 1,\n+  \"original_accepted\": false,\n+  \"source_clean_after\": true,\n+  \"phases\": [\n+    {\n+      \"label\": \"W7\",\n+      \"variant\": \"fixed\",\n+      \"state\": \"COMPLETED\",\n+      \"actual_exit\": 0,\n+      \"passed\": true,\n+      \"observation_complete\": true\n+    },\n+    {\n+      \"label\": \"H7\",\n+      \"variant\": \"fixed\",\n+      \"state\": \"COMPLETED\",\n+      \"actual_exit\": 1,\n+      \"passed\": false,\n+      \"observation_complete\": true\n+    },\n+    {\n+      \"label\": \"count-fixed\",\n+      \"variant\": \"fixed\",\n+      \"state\": \"COMPLETED\",\n+      \"actual_exit\": 1,\n+      \"passed\": false,\n+      \"observation_complete\": true\n+    },\n+    {\n+      \"label\": \"count-withdrawn\",\n+      \"variant\": \"withdrawn\",\n+      \"state\": \"COMPLETED\",\n+      \"actual_exit\": 1,\n+      \"passed\": true,\n+      \"observation_complete\": true\n+    },\n+    {\n+      \"label\": \"count-restored\",\n+      \"variant\": \"restored\",\n+      \"state\": \"COMPLETED\",\n+      \"actual_exit\": 1,\n+      \"passed\": false,\n+      \"observation_complete\": true\n+    },\n+    {\n+      \"label\": \"population-fixed\",\n+      \"variant\": \"fixed\",\n+      \"state\": \"COMPLETED\",\n+      \"actual_exit\": 1,\n+      \"passed\": false,\n+      \"observation_complete\": true\n+    },\n+    {\n+      \"label\": \"population-withdrawn\",\n+      \"variant\": \"withdrawn\",\n+      \"state\": \"COMPLETED\",\n+      \"actual_exit\": 1,\n+      \"passed\": true,\n+      \"observation_complete\": true\n+    },\n+    {\n+      \"label\": \"population-restored\",\n+      \"variant\": \"restored\",\n+      \"state\": \"COMPLETED\",\n+      \"actual_exit\": 1,\n+      \"passed\": false,\n+      \"observation_complete\": true\n+    },\n+    {\n+      \"label\": \"unplaced_replay-fixed\",\n+      \"variant\": \"fixed\",\n+      \"state\": \"COMPLETED\",\n+      \"actual_exit\": 1,\n+      \"passed\": false,\n+      \"observation_complete\": true\n+    },\n+    {\n+      \"label\": \"unplaced_replay-withdrawn\",\n+      \"variant\": \"withdrawn\",\n+      \"state\": \"COMPLETED\",\n+      \"actual_exit\": 1,\n+      \"passed\": false,\n+      \"observation_complete\": true\n+    },\n+    {\n+      \"label\": \"unplaced_replay-restored\",\n+      \"variant\": \"restored\",\n+      \"state\": \"COMPLETED\",\n+      \"actual_exit\": 1,\n+      \"passed\": false,\n+      \"observation_complete\": true\n+    }\n+  ],\n+  \"roundtrip_all_bytes_equal\": true,\n+  \"original_bytes\": 81271864,\n+  \"created_utc\": \"2026-10-24T04:23:34.136962+00:00\",\n+  \"limits\": [\n+    \"Only original W7/H7 and three helper triples; not full native/browser/ledger/architecture or performance.\",\n+    \"Original compiler text=True outputs retain decoded-text representation; original binary run/Bridge pipes captured before decoding.\",\n+    \"Original subprocess TimeoutExpired may have no CompletedProcess returncode or output; do not invent a child exit.\",\n+    \"Actual scene supplement is a point-in-time copy while H7 is active, not pre-execution capture. Later short phase fixtures may be represented by original source and input paths only.\",\n+    \"Original NativeBuild cleanup retained unchanged; source/command/ELF hashes are not retained ELF payloads.\"\n+  ]\n+}"},{"sha":"a5e81df33b85e798cc58661efb4425585d822235","filename":"evidence/geo300-capacity512-20261024/formal-F73b21e64/independent-peers/F0f/REVIEW.json","status":"added","additions":101959,"deletions":0,"changes":101959,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF0f%2FREVIEW.json","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF0f%2FREVIEW.json","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF0f%2FREVIEW.json?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f"},{"sha":"c60903a715e717d7a777a072255227c4ffb82c9e","filename":"evidence/geo300-capacity512-20261024/formal-F73b21e64/independent-peers/F0f/TERMINAL_REVIEW.json","status":"added","additions":7371,"deletions":0,"changes":7371,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF0f%2FTERMINAL_REVIEW.json","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF0f%2FTERMINAL_REVIEW.json","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF0f%2FTERMINAL_REVIEW.json?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f"},{"sha":"252cf8641d3afd186467c297d34af137def4a659","filename":"evidence/geo300-capacity512-20261024/formal-F73b21e64/independent-peers/F0f/review_F0f_terminal.initial-syntax.py.txt","status":"added","additions":32,"deletions":0,"changes":32,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF0f%2Freview_F0f_terminal.initial-syntax.py.txt","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF0f%2Freview_F0f_terminal.initial-syntax.py.txt","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF0f%2Freview_F0f_terminal.initial-syntax.py.txt?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f","patch":"@@ -0,0 +1,32 @@\n+from pathlib import Path\n+import hashlib,json\n+B=Path('/workspace/geo348-F0f695866-formal');L=Path('/workspace/geo348-F0f695866-formal-launch');O=Path('/workspace/archive-package-peer-specials-20261024/geo348-F0f');S='0f695866c0ba12d2c70dfd7d40628d0fda0f905f'\n+def j(p):return json.loads(p.read_bytes())\n+def sha(b):return hashlib.sha256(b).hexdigest()\n+checks=[]\n+def ck(v,l):checks.append({'check':l,'passed':bool(v)})\n+r=j(B/'RESULT.json');outer=j(L/'receipt.json');ck(r['source_sha']==outer['source']==S,'source original F0f');ck(r['exit_code']==outer['launcher_exit']==outer['primary_returncode']==outer['reaper_process_exit']==1,'all true original exits1');ck(outer['metadata_problems']==[] and outer['reaper_complete_events']==1,'true outer complete');ck(r['accepted']is False and r['source_clean_after']is True and r['errors']==[],'honest failed verdict with restoration');ck(len(r['phases'])==11,'all11 original phases')\n+rawcount=0\n+for root in [B,L]:\n+ for p in sorted(root.glob('subcommands/*/result.json')):\n+  x=j(p);rawcount+=1\n+  for n in ['stdout','stderr']:\n+   b=(p.parent/(n+'.bin')).read_bytes();ck(len(b)==x[n+'_bytes'] and sha(b)==x[n+'_sha256'],'c387 '+str(p.parent)+' '+n)\n+  ck(type(x['actual_process_returncode'])is int and not x['timeout_expired'],'c387 actual terminal '+str(p.parent))\n+phase=[];timeouts=[];observed_commands=0\n+for n,p in enumerate(r['phases']):\n+ d=B/p['label'];m=j(d/'manifest.json');e=j(d/'observed/ORIGINAL_ENTRY.json');ob=j(d/'observed/OBSERVATION.json');c=j(Path(p['command_directory'])/'result.json');ck(p['state']=='COMPLETED' and p['actual_exit']==c['actual_process_returncode']==e['original_exit'],'phase actual exit '+p['label']);ck(p['actual_exit']==(0 if n==0 else 1),'original red pattern '+p['label']);ck(e['source_sha']==ob['source_sha']==m['source_sha']==S and e['source_variant']==m['source_variant']==p['variant'],'phase source '+p['label']);ck(e['original_completed']is True and e['observer_complete']is True and ob['observer_complete']is True and p['observation_complete']is True,'dual observation '+p['label']);ck(e['source_files_before']==e['source_files_after']==m['files'],'exact phase source manifest '+p['label']);ck(p['source_exact_after']is True,'phase source restored/exact '+p['label']);ck(ob['incomplete_sessions']==[] and ob['observation_errors']==[],'no observation errors '+p['label'])\n+ rows=list((d/'observed').glob('command-*/receipt.json'));ck(len(rows)==ob['commands'],'observed count '+p['label'])\n+ for f in rows:\n+  q=j(f);observed_commands+=1\n+  for name in ['stdout','stderr']:\n+   v=q[name]\n+   if v.get('captured'):\n+    b=(f.parent/(name+'.bin')).read_bytes();ck(len(b)==v['bytes'] and sha(b)==v['sha256'],'observed stream '+str(f.parent)+' '+name)\n+  if q['exception'] is not None and 'TimeoutExpired' in str(q['exception']):\n+   timeouts.append({'phase':p['label'],'path':str(f),'returncode':q['returncode'],'exception':q['exception'],'kwargs':q['kwargs']});ck(q['returncode']is None and q['completed_process_returned']is False and q['kwargs']['timeout']==600,'genuine600 timeout no invented OS exit')\n+ phase.append({k:p[k]for k in ['label','variant','actual_exit','passed','observation_complete']})\n+w=r['phases'][0]['runner'];h=r['phases'][1]['runner'];ck(w['total']==w['run']==w['passed']==7 and w['failed']==w['skipped']==0,'W7 7pass0skip');ck(h['total']==h['run']==7 and h['passed']==2 and h['failed']==5 and h['skipped']==0,'H7 2pass5red0skip');fail=h['failures'];ck(sum(x['kind']=='failure' and '角材的數量超過上限' in x['message'] and '欄位數不對' in x['message']for x in fail)==3,'three exact dispatcher/capacity assertion reds');ck(sum(x['kind']=='error' and 'TimeoutExpired' in x['message'] and '600 seconds' in x['message']for x in fail)==2 and len(timeouts)==2,'two real placed512600 timeout reds')\n+for name in ['count','population','unplaced_replay']:\n+ a=[p for p in r['phases']if p['label'].startswith(name+'-')];ck(len(a)==3 and [x['actual_exit']for x in a]==[1,1,1] and not all(x['passed']for x in a),'not valid passing helper triple '+name)\n+report={'scope':'Independent existing F0f terminal/raw verdict audit; no original command rerun','source_sha':S,'passed':sum(x['passed']for x in checks),'failed':sum(not x['passed']for x in checks),'exit':0 if all(x['passed']for x in checks)else1,'c387_commands':rawcount,'observed_commands':observed_commands,'phases':phase,'timeouts':timeouts,'checks':checks,'limits':['W7 green only; H7 and all three helper triples remain failed at F0f.','TimeoutExpired has no CompletedProcess or OS exit; no compiler/crash event is called a semantic kill.','Old actual scene supplement was captured while H7 was active, not before send; missing older per-helper fixtures are not reconstructed.','Initial exploratory schema read treated OBSERVATION.commands integer as a list and raised TypeError; only the reviewer query was corrected; original receipt untouched.']};(O/'TERMINAL_REVIEW.json').write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\\n');print(json.dumps({k:report[k]for k in ['passed','failed','exit','c387_commands','observed_commands']}));print(sha((O/'TERMINAL_REVIEW.json').read_bytes()));raise SystemExit(report['exit'])"},{"sha":"dfbd63501dc6c8ea7fc6a29d2da6259323c333eb","filename":"evidence/geo300-capacity512-20261024/formal-F73b21e64/independent-peers/F0f/review_F0f_terminal.py","status":"added","additions":32,"deletions":0,"changes":32,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF0f%2Freview_F0f_terminal.py","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF0f%2Freview_F0f_terminal.py","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF0f%2Freview_F0f_terminal.py?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f","patch":"@@ -0,0 +1,32 @@\n+from pathlib import Path\n+import hashlib,json\n+B=Path('/workspace/geo348-F0f695866-formal');L=Path('/workspace/geo348-F0f695866-formal-launch');O=Path('/workspace/archive-package-peer-specials-20261024/geo348-F0f');S='0f695866c0ba12d2c70dfd7d40628d0fda0f905f'\n+def j(p):return json.loads(p.read_bytes())\n+def sha(b):return hashlib.sha256(b).hexdigest()\n+checks=[]\n+def ck(v,l):checks.append({'check':l,'passed':bool(v)})\n+r=j(B/'RESULT.json');outer=j(L/'receipt.json');ck(r['source_sha']==outer['source']==S,'source original F0f');ck(r['exit_code']==outer['launcher_exit']==outer['primary_returncode']==outer['reaper_process_exit']==1,'all true original exits1');ck(outer['metadata_problems']==[] and outer['reaper_complete_events']==1,'true outer complete');ck(r['accepted']is False and r['source_clean_after']is True and r['errors']==[],'honest failed verdict with restoration');ck(len(r['phases'])==11,'all11 original phases')\n+rawcount=0\n+for root in [B,L]:\n+ for p in sorted(root.glob('subcommands/*/result.json')):\n+  x=j(p);rawcount+=1\n+  for n in ['stdout','stderr']:\n+   b=(p.parent/(n+'.bin')).read_bytes();ck(len(b)==x[n+'_bytes'] and sha(b)==x[n+'_sha256'],'c387 '+str(p.parent)+' '+n)\n+  ck(type(x['actual_process_returncode'])is int and not x['timeout_expired'],'c387 actual terminal '+str(p.parent))\n+phase=[];timeouts=[];observed_commands=0\n+for n,p in enumerate(r['phases']):\n+ d=B/p['label'];m=j(d/'manifest.json');e=j(d/'observed/ORIGINAL_ENTRY.json');ob=j(d/'observed/OBSERVATION.json');c=j(Path(p['command_directory'])/'result.json');ck(p['state']=='COMPLETED' and p['actual_exit']==c['actual_process_returncode']==e['original_exit'],'phase actual exit '+p['label']);ck(p['actual_exit']==(0 if n==0 else 1),'original red pattern '+p['label']);ck(e['source_sha']==ob['source_sha']==m['source_sha']==S and e['source_variant']==m['source_variant']==p['variant'],'phase source '+p['label']);ck(e['original_completed']is True and e['observer_complete']is True and ob['observer_complete']is True and p['observation_complete']is True,'dual observation '+p['label']);ck(e['source_files_before']==e['source_files_after']==m['files'],'exact phase source manifest '+p['label']);ck(p['source_exact_after']is True,'phase source restored/exact '+p['label']);ck(ob['incomplete_sessions']==[] and ob['observation_errors']==[],'no observation errors '+p['label'])\n+ rows=list((d/'observed').glob('command-*/receipt.json'));ck(len(rows)==ob['commands'],'observed count '+p['label'])\n+ for f in rows:\n+  q=j(f);observed_commands+=1\n+  for name in ['stdout','stderr']:\n+   v=q[name]\n+   if v.get('captured'):\n+    b=(f.parent/(name+'.bin')).read_bytes();ck(len(b)==v['bytes'] and sha(b)==v['sha256'],'observed stream '+str(f.parent)+' '+name)\n+  if q['exception'] is not None and 'TimeoutExpired' in str(q['exception']):\n+   timeouts.append({'phase':p['label'],'path':str(f),'returncode':q['returncode'],'exception':q['exception'],'kwargs':q['kwargs']});ck(q['returncode']is None and q['completed_process_returned']is False and q['kwargs']['timeout']==600,'genuine600 timeout no invented OS exit')\n+ phase.append({k:p[k]for k in ['label','variant','actual_exit','passed','observation_complete']})\n+w=r['phases'][0]['runner'];h=r['phases'][1]['runner'];ck(w['total']==w['run']==w['passed']==7 and w['failed']==w['skipped']==0,'W7 7pass0skip');ck(h['total']==h['run']==7 and h['passed']==2 and h['failed']==5 and h['skipped']==0,'H7 2pass5red0skip');fail=h['failures'];ck(sum(x['kind']=='failure' and '角材的數量超過上限' in x['message'] and '欄位數不對' in x['message']for x in fail)==3,'three exact dispatcher/capacity assertion reds');ck(sum(x['kind']=='error' and 'TimeoutExpired' in x['message'] and '600 seconds' in x['message']for x in fail)==2 and len(timeouts)==2,'two real placed512600 timeout reds')\n+for name in ['count','population','unplaced_replay']:\n+ a=[p for p in r['phases']if p['label'].startswith(name+'-')];ck(len(a)==3 and [x['actual_exit']for x in a]==[1,1,1] and not all(x['passed']for x in a),'not valid passing helper triple '+name)\n+report={'scope':'Independent existing F0f terminal/raw verdict audit; no original command rerun','source_sha':S,'passed':sum(x['passed']for x in checks),'failed':sum(not x['passed']for x in checks),'exit':0 if all(x['passed']for x in checks)else 1,'c387_commands':rawcount,'observed_commands':observed_commands,'phases':phase,'timeouts':timeouts,'checks':checks,'reviewer_history':'Initial helper had else1 SyntaxError before any read/audit; corrected spacing only, source receipts unchanged.','limits':['W7 green only; H7 and all three helper triples remain failed at F0f.','TimeoutExpired has no CompletedProcess or OS exit; no compiler/crash event is called a semantic kill.','Old actual scene supplement was captured while H7 was active, not before send; missing older per-helper fixtures are not reconstructed.','Initial exploratory schema read treated OBSERVATION.commands integer as a list and raised TypeError; only the reviewer query was corrected; original receipt untouched.']};(O/'TERMINAL_REVIEW.json').write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\\n');print(json.dumps({k:report[k]for k in ['passed','failed','exit','c387_commands','observed_commands']}));print(sha((O/'TERMINAL_REVIEW.json').read_bytes()));raise SystemExit(report['exit'])"},{"sha":"21989f624f6a485972fce7d3a3d5941ec61dd9da","filename":"evidence/geo300-capacity512-20261024/formal-F73b21e64/independent-peers/F0f/review_package.py","status":"added","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF0f%2Freview_package.py","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF0f%2Freview_package.py","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF0f%2Freview_package.py?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f","patch":"@@ -0,0 +1,19 @@\n+from pathlib import Path,PurePosixPath\n+import hashlib,json,sys,tarfile\n+B=Path(sys.argv[1]);expected=sys.argv[2];S=sys.argv[3];count=int(sys.argv[4]);expected_exit=int(sys.argv[5]);O=Path(sys.argv[6]);O.mkdir(exist_ok=False)\n+def sha(b):return hashlib.sha256(b).hexdigest()\n+checks=[]\n+def ck(v,l):\n+ checks.append({'check':l,'passed':bool(v)})\n+idx=json.loads((B/'RAW_INDEX.json').read_bytes());summ=json.loads((B/'SUMMARY.json').read_bytes());archive=B/idx['archive'];rows=idx['files'];ck(idx['source_sha']==summ['source_sha']==S,'source exact');ck(sha(archive.read_bytes())==idx['archive_sha256']==summ['archive_sha256']==expected,'archive whole pin');ck(archive.stat().st_size==idx['archive_bytes']==summ['archive_bytes'],'archive byte length');ck(len(rows)==idx['member_count']==summ['member_count']==count,'exact member count');ck(summ['original_exit']==expected_exit,'original exit preserved');ck(sum(r['bytes'] for r in rows)==summ['original_bytes'],'original byte total');ck(len({r['member'] for r in rows})==count,'unique member names');errors=[];total=0\n+with tarfile.open(archive,'r:gz') as tf:\n+ members=tf.getmembers();ck(len(members)==count,'tar members');\n+ for m,r in zip(members,rows):\n+  name=PurePosixPath(m.name);raw=tf.extractfile(m).read() if m.isfile() else b'';p=Path(r['source']);orig=p.read_bytes();total+=len(raw)\n+  ck(m.isfile() and m.name==r['member'] and not name.is_absolute() and '..' not in name.parts,'regular exact safe member '+m.name)\n+  ck(len(raw)==m.size==r['bytes'] and sha(raw)==r['sha256'],'archive bytes/hash '+m.name)\n+  ck(raw==orig and not p.is_symlink(),'whole original equality '+m.name)\n+  ck(not raw.startswith(b'\\x7fELF'),'no ELF payload '+m.name)\n+ck(total==summ['original_bytes'],'roundtrip total')\n+report={'scope':'Independent archive/index/original-byte roundtrip audit only; no product or formal rerun','archive':str(archive),'source_sha':S,'archive_sha256':expected,'index_sha256':sha((B/'RAW_INDEX.json').read_bytes()),'summary_sha256':sha((B/'SUMMARY.json').read_bytes()),'member_count':count,'original_bytes':total,'passed':sum(x['passed']for x in checks),'failed':sum(not x['passed']for x in checks),'exit':0 if all(x['passed']for x in checks) else 1,'limitations':['This audit establishes archive fidelity; raw semantic verdict peer is a separate referenced output.','No Git/source/build mutation and no C or browser execution.'],'checks':checks}\n+(O/'REVIEW.json').write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\\n');print(json.dumps({k:report[k]for k in ['source_sha','member_count','original_bytes','passed','failed','exit']}));print(sha((O/'REVIEW.json').read_bytes()));raise SystemExit(report['exit'])"},{"sha":"042c058dd27a05c5cb5cbac1bd66f6477a583601","filename":"evidence/geo300-capacity512-20261024/formal-F73b21e64/independent-peers/F73/CURRENT_DOC_REVIEW.json","status":"added","additions":114,"deletions":0,"changes":114,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF73%2FCURRENT_DOC_REVIEW.json","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF73%2FCURRENT_DOC_REVIEW.json","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF73%2FCURRENT_DOC_REVIEW.json?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f","patch":"@@ -0,0 +1,114 @@\n+{\n+  \"scope\": \"Current F73 body/progress only, checked against existing referenced peer summaries and previously accepted F73 scope; no tar, C, tests or new Git/network.\",\n+  \"body_sha256\": \"fbb57b732d9d8977c85ee0762083607987043f2a0c9fdb8296d31bd11bc6bbb2\",\n+  \"progress_sha256\": \"873be14c409de300d12903245099218f