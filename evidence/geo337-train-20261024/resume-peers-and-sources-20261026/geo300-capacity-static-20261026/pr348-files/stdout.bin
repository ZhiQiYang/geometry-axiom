False));raise SystemExit(report['exit'])"},{"sha":"e3ca89076d5e8bb4f6fe738adb445125325dadde","filename":"evidence/geo300-capacity512-20261024/formal-F73b21e64/independent-peers/F73/actual/review.py","status":"added","additions":62,"deletions":0,"changes":62,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF73%2Factual%2Freview.py","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF73%2Factual%2Freview.py","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF73%2Factual%2Freview.py?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f","patch":"@@ -0,0 +1,62 @@\n+from pathlib import Path\n+import hashlib,json,re\n+O=Path(__file__).resolve().parent\n+F='73b21e64dce72f0d16ca29e18559c51815b9724d';leaf='tests/test_geo261_timber_capacity_host.py'\n+A=Path('/workspace/geo348-F73b21e64-formal');B=Path('/workspace/geo348-F73b21e64-sentinel-resume');checks=[]\n+def ck(x,m):checks.append({'check':m,'passed':bool(x)})\n+def sha(b):return hashlib.sha256(b).hexdigest()\n+def load(p):return json.loads(p.read_text())\n+a=load(A/'RESULT.json');b=load(B/'RESULT.json')\n+ck(sha((A/'RESULT.json').read_bytes())=='23119c194be860059362672980d984c805838f5227c83788c3d2522b7fbc29c0','original first batch exact receipt')\n+ck(sha((B/'RESULT.json').read_bytes())=='f61c80f1335c1c05e82d094c54f978717fe51fe1c6801f2dab52429acf8dd5c2','resume exact receipt')\n+ck(a['exit_code']==1 and not a['accepted'],'original environment-limited outer red retained')\n+ck(b['exit_code']==0 and b['accepted'],'environment-only last-three resume accepted')\n+ck(b['prior_partial_sha256']==sha((A/'RESULT.json').read_bytes())and not b['prior_ten_phases_rerun'],'resume binds first original receipt and no rerun first ten')\n+for r in [a,b]:\n+ ck(r['source_sha']==F and r['source_clean_after']and not r['errors'],'same F and source clean terminal')\n+ ck(not r['full_H7_executed']and not r['unfixed_512_methods_rerun']and not r['full_native']and not r['ledger_regenerated']and not r['performance'],'no full H7/native/ledger/performance claims')\n+ck(len(a['phases'])==13 and len(b['phases'])==3,'original planned 13/resumed3')\n+for p in a['phases'][10:]:ck(p['state']=='UNRUN_ENVIRONMENT'and p.get('actual_exit')is None and not p['passed'],'original environment-unrun preserved '+p['label'])\n+phases=a['phases'][:10]+b['phases'];ck(len(phases)==13,'exact completed logical phase count')\n+fixed=Path('/workspace/geo348-sentinel-fix-draft-20261024/candidate.py').read_bytes();ck(sha(fixed)=='abe3ab96bfbda4fd4a535558c0b95294c0bcdccabec7ba129ea2b13cdac8b740','accepted F73 host fixed bytes')\n+wr=Path('/workspace/geo300-capacity512-publication-20261024/host-v5-draft/EXACT_WITHDRAWALS.json').read_bytes();ck(sha(wr)=='48bf7a7cacc8f3de143a1903210b14ad43aa17d8bf69edcda71e6e94419613cc','three old exact withdrawal snippets pinned');w=json.loads(wr)\n+variants={}\n+for name,row in w.items():\n+ before=row['before'].encode();after=row['after'].encode();ck(fixed.count(after)==1,'withdrawal applied only exact original fixed helper '+name);variants[name]=sha(fixed.replace(after,before,1))\n+needle=b'SAFE_INCOMPLETE_DECLARATION=\"timber 513 27 33\"'\n+if needle not in fixed:\n+ needle=b'SAFE_INCOMPLETE_DECLARATION = \"timber 513 27 33\"'\n+# Read actual constant spelling; no substring-wide test changes.\n+lines=[x for x in fixed.splitlines(keepends=True)if b'=\"timber 513 27 33\"'in x or b'= \"timber 513 27 33\"'in x]\n+ck(len(lines)==1,'exact one fixed sentinel constant')\n+sentinel=lines[0];variants['sentinel_fix']=sha(fixed.replace(sentinel,sentinel.replace(b'\"timber 513 27 33\"',b'\"timber\"'),1))\n+markers={'count':'AssertionError: Lists differ:', 'population':'角材 1 沒有 place（收尾時仍未放置，I9）','unplaced_replay':'self.assertTrue(restored.command(\"loadfile \"+str(replay))[\"ok\"])','sentinel_fix':'host-capacity-first-incomplete-declaration'}\n+base_source=phases[0]['entry']['source_files_before'];details=[]\n+for p in phases:\n+ label=p['label'];entry=p['entry'];obs=p['observation'];negative=p['negative'];expected=1 if negative else 0;q=Path(p['command_directory']);cr=load(q/'result.json');stdout=(q/'stdout.bin').read_bytes();stderr=(q/'stderr.bin').read_bytes();count=p['original_expected_methods']\n+ ck(p['state']=='COMPLETED'and p['actual_exit']==expected and p['passed'],'actual phase return '+label)\n+ ck(cr['actual_process_returncode']==expected and not cr['timeout_expired']and cr['source_sha']==F,'raw original capture exit/source/no timeout '+label)\n+ ck(sha(stdout)==cr['stdout_sha256']and sha(stderr)==cr['stderr_sha256']and len(stdout)==cr['stdout_bytes']and len(stderr)==cr['stderr_bytes'],'raw exact stdout/stderr '+label)\n+ ck(cr['command']==p['argv']and p['original_argv'][2:] == p['argv'][p['argv'].index('--')+1:],'original selected unittest command '+label)\n+ ck(entry['original_completed']and entry['original_exit']==expected and entry['original_exception']=={'type':'SystemExit','repr':f'SystemExit({expected})'},'normal original unittest SystemExit '+label)\n+ ck(p['observation_complete']and obs['observer_complete']and not obs['incomplete_sessions']and not obs['observation_errors']and entry['observer_complete'],'complete observer metadata '+label)\n+ ck(entry['source_sha']==F and entry['postflight_head']['exit']==0 and bytes.fromhex(entry['postflight_head']['stdout_hex']).decode()==F+'\\n' and entry['postflight_head']['stderr_hex']=='' and entry['source_files_before']==entry['source_files_after'],'exact stable phase source '+label)\n+ expected_source=dict(base_source);expected_source[leaf]=variants[negative]if negative else sha(fixed)\n+ ck(entry['source_files_before']==expected_source,'only exact permitted test-helper variant '+label)\n+ ck(p['source_exact_after']and entry['postflight_status']['exit']==0 and bytes.fromhex(entry['postflight_status']['stdout_hex']).decode()==(' M '+leaf+'\\n'if negative else '') and entry['postflight_status']['stderr_hex']=='','source dirt only declared variant '+label)\n+ text=stderr.decode();ck(re.search(r'Ran '+str(count)+r' tests? in ',text)is not None and 'skipped='not in text,'original method count/no skip '+label)\n+ if negative:\n+  ck('FAILED (failures=1)'in text and 'AssertionError:'in text and markers[negative]in text and 'ERROR:'not in text,'specific normal assertion cause '+label)\n+ else:ck(text.rstrip().endswith('OK')and 'FAILED'not in text,'normal positive formal result '+label)\n+ details.append({'label':label,'actual_exit':expected,'methods':count,'stdout_bytes':len(stdout),'stderr_bytes':len(stderr),'cause':markers.get(negative),'source_host_sha256':entry['source_files_before'][leaf]})\n+for start in [1,4,7,10]:ck([p['actual_exit']for p in phases[start:start+3]]==[0,1,0],'normal adjacent original trio '+phases[start]['label'])\n+for root,exitcode in [(A,1),(B,0)]:\n+ top=root.with_name(root.name+'-launch');receipt=load(top/'receipt.json');completion=load(top/'EXEC_COMPLETION.json')\n+ ck(completion['exit_code']==exitcode,'real tool process exit '+root.name)\n+ ck(receipt['source']==F,'top launcher source '+root.name)\n+ scalars={k:v for k,v in receipt.items()if not isinstance(v,(list,dict))}\n+ (O/(root.name+'-outer-scalars.json')).write_text(json.dumps(scalars,ensure_ascii=False,indent=2)+'\\n')\n+failed=[c for c in checks if not c['passed']]\n+(O/'CHECKS.json').write_text(json.dumps(checks,ensure_ascii=False,indent=2)+'\\n')\n+report={'exit':int(bool(failed)),'checks':len(checks),'passed':len(checks)-len(failed),'findings':failed,'source':F,'phases':details,'reviewer_correction':'Preserved initial helper/report mistakes: UNRUN_ENVIRONMENT omits actual_exit, and observer postflight values are exit/stdout_hex/stderr_hex records, not strings. Reader corrected to actual schema; subject and receipts unchanged.', 'scope':'Small actual terminal/command streams/source-version hashes and exact assertion causes review. No C rerun, Git writes, complete compiler/pipe/session-payload archive walk or large hashing during exclusive R5. Full underlying capture/compiled inputs package integrity remains separate pending review. Original first outer exit1 remains environment incomplete, resumed last3 outer0. Does not validate either deferred true placed512 method, full H7, native, ledger, architecture or performance.'}\n+(O/'REVIEW.json').write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\\n');print(json.dumps({k:report[k]for k in ['exit','checks','passed','findings']},ensure_ascii=False));raise SystemExit(report['exit'])"},{"sha":"eedf16572682a705ed6553808a2f74df9297e093","filename":"evidence/geo300-capacity512-20261024/formal-F73b21e64/independent-peers/F73/review_package.py","status":"added","additions":34,"deletions":0,"changes":34,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF73%2Freview_package.py","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF73%2Freview_package.py","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Findependent-peers%2FF73%2Freview_package.py?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f","patch":"@@ -0,0 +1,34 @@\n+\"\"\"Independent compact archive/descriptor review; no C, extraction or mutation.\"\"\"\n+from pathlib import Path\n+import hashlib,json,os,stat,tarfile\n+P=Path('/workspace/geo348-F73b21e64-formal-with-resume-package-r2');O=Path('/workspace/geo348-F73-package-peer-combined-20261024');O.mkdir(exist_ok=False)\n+checks=0;failures=[]\n+def check(value,label):\n+ global checks\n+ checks+=1\n+ if not value:failures.append(label)\n+def sha(b):return hashlib.sha256(b).hexdigest()\n+def read(p):return json.loads(p.read_bytes())\n+j=read(P/'RAW_INDEX.json');s=read(P/'SUMMARY.json');a=P/j['archive'];rows=j['files']\n+check(j['source_sha']=='73b21e64dce72f0d16ca29e18559c51815b9724d','source');check(j['member_count']==len(rows)==5901,'member count');check(a.stat().st_size==j['archive_bytes']==13842178,'archive bytes');check(sha(a.read_bytes())==j['archive_sha256']=='72eb29033c8d7d6bed80fd045ba302846313815ca0953a8aa5148abbbf0c3b23','archive pin')\n+check(len({r['member']for r in rows})==len(rows),'unique member names');total=0\n+with tarfile.open(a,'r:gz')as tf:\n+ members=tf.getmembers();check(len(members)==len(rows),'actual tar count')\n+ for row,member in zip(rows,members):\n+  check(member.isfile() and member.name==row['member'],'member type/order '+row['member']);raw=tf.extractfile(member).read();path=Path(row['source']);st=path.lstat()\n+  check(stat.S_ISREG(st.st_mode)and not path.is_symlink(),'original regular '+row['member'])\n+  check(len(raw)==row['bytes'] and sha(raw)==row['sha256'],'indexed member bytes '+row['member']);check(raw==path.read_bytes(),'actual original bytes '+row['member']);total+=len(raw)\n+check(total==s['original_bytes']==92383591,'total original regular/descriptor bytes')\n+descriptor=read(P/'SPECIAL_FIXTURE_ENTRIES.json')['entries'];check(len(descriptor)==6,'exact special inventory')\n+check(sorted(x['original_kind']for x in descriptor)==['fifo']*3+['symlink']*3,'three fifo plus three symlink')\n+for item in descriptor:\n+ path=Path(item['original_path']);st=path.lstat();check(st.st_mode==item['mode'],'original special lstat '+str(path));expected_kind='symlink' if stat.S_ISLNK(st.st_mode)else 'fifo' if stat.S_ISFIFO(st.st_mode)else 'other';check(expected_kind==item['original_kind'],'original special kind '+str(path))\n+ if expected_kind=='symlink':check(os.readlink(os.fsencode(path)).hex()==item['readlink_bytes_hex'],'exact raw readlink '+str(path))\n+ else:check(item['readlink_bytes_hex'] is None,'FIFO metadata only '+str(path))\n+ check(not any(r['source']==str(path)for r in rows),'special not misrepresented as regular '+str(path))\n+first=read(Path('/workspace/geo348-F73b21e64-formal/RESULT.json'));resume=read(Path('/workspace/geo348-F73b21e64-sentinel-resume/RESULT.json'))\n+check(first['exit_code']==s['original_partial_exit']==1 and first['accepted'] is False,'original environment red preserved');check(resume['exit_code']==s['environment_resume_exit']==0 and resume['accepted'] is True,'separate resume true0')\n+check(len(first['phases'])==13 and all(x['passed'] for x in first['phases'][:10]),'first ten phases complete');check(all(x['state']=='UNRUN_ENVIRONMENT' for x in first['phases'][10:]),'last three original environment unrun')\n+check([x['actual_exit']for x in resume['phases']]==[0,1,0]and all(x['passed']and x['observation_complete']for x in resume['phases']),'resume exact normal0/1/0 complete');check(first['source_clean_after']and resume['source_clean_after'],'both source clean')\n+result={'source_sha':j['source_sha'],'checks':checks,'failed_checks':len(failures),'failures':failures,'member_count':len(rows),'archive_sha256':j['archive_sha256'],'original_regular_and_descriptor_bytes':total,'special_entry_count':6,'first_batch_exit':1,'resume_exit':0,'scope':'Independent full archive/original-byte roundtrip and exact six lstat/readlink descriptors; small true terminal phase projection. No C, tar extraction, archive rewrite, or independent full H/pipe/ELF semantic rerun. Backlog171 actual covers the separate targeted native assertions.','limits':['Original firstbatch exit1 is retained; resume0 does not relabel the old batch.','Neither unresolved512 placed method, fullH7, native/browser/ledger/architecture is certified by this package.','FIFO streams never opened and symlink targets never followed.']}\n+(O/'REVIEW.json').write_text(json.dumps(result,ensure_ascii=False,indent=2)+'\\n');print(json.dumps({'checks':checks,'failed_checks':len(failures),'review':str(O/'REVIEW.json'),'sha256':sha((O/'REVIEW.json').read_bytes())}));raise SystemExit(bool(failures))"},{"sha":"3f9408bf205b62ec6817a68357fc80bc2ca12404","filename":"evidence/geo300-capacity512-20261024/formal-F73b21e64/prepare_file_allowlist.py","status":"added","additions":40,"deletions":0,"changes":40,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fprepare_file_allowlist.py","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fprepare_file_allowlist.py","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fprepare_file_allowlist.py?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f","patch":"@@ -0,0 +1,40 @@\n+\"\"\"Prepare immutable original evidence paths; does not hash archives or touch Git.\"\"\"\n+from pathlib import Path\n+import hashlib,json\n+P=Path(__file__).resolve().parent\n+PREFIX='evidence/geo300-capacity512-20261024/formal-F73b21e64/'\n+files=[]\n+def add(local,relative,known=None):\n+    p=Path(local);assert p.is_file()and not p.is_symlink()\n+    if known:\n+        size,digest=known;assert p.stat().st_size==size\n+    else:\n+        b=p.read_bytes();size=len(b);digest=hashlib.sha256(b).hexdigest()\n+    files.append({'local':str(p),'relative':PREFIX+relative,'bytes':size,'sha256':digest,'archive_preload_required':known is not None})\n+old=Path('/workspace/geo348-F0f695866-formal-package')\n+add(old/'ORIGINAL_W7_H7_AND_HELPER_TRIPLES.tar.gz','historical-F0f/ORIGINAL_W7_H7_AND_HELPER_TRIPLES.tar.gz',(12616070,'dbe988b880024aee708d85d3b0364adf5ab61c9587f861271d8e2170755b37a7'))\n+for name in ['RAW_INDEX.json','SUMMARY.json']:add(old/name,'historical-F0f/'+name)\n+new=Path('/workspace/geo348-F73b21e64-formal-with-resume-package-r2')\n+add(new/'ORIGINAL_AFFECTED_H3_HELPERS_AND_ENVIRONMENT_RESUME.tar.gz','targeted-F73/ORIGINAL_AFFECTED_H3_HELPERS_AND_ENVIRONMENT_RESUME.tar.gz',(13842178,'72eb29033c8d7d6bed80fd045ba302846313815ca0953a8aa5148abbbf0c3b23'))\n+for name in ['RAW_INDEX.json','SUMMARY.json','SPECIAL_FIXTURE_ENTRIES.json','EXEC_LAUNCH.json','EXEC_COMPLETION.json']:add(new/name,'targeted-F73/'+name)\n+peer=Path('/workspace/archive-package-peer-specials-20261024')\n+for name in ['REVIEW.json','TERMINAL_REVIEW.json']:add(peer/'geo348-F0f'/name,'independent-peers/F0f/'+name)\n+for name in ['review_package.py','review_F0f_terminal.py','review_F0f_terminal.initial-syntax.py.txt']:add(peer/name,'independent-peers/F0f/'+name)\n+add('/workspace/geo348-F73-package-peer-combined-20261024/REVIEW.json','independent-peers/F73/PACKAGE_REVIEW.json')\n+add('/workspace/review_geo348_f73_package_compact_20261024.py','independent-peers/F73/review_package.py')\n+peer=Path('/workspace/geo348-F73-partial-actual-peer-backlog-20261024')\n+for p in sorted(peer.iterdir()):\n+    if p.is_file():add(p,'independent-peers/F73/actual/'+p.name)\n+add('/workspace/geo348-F73-body-peer-specials-20261024/REVIEW.json','independent-peers/F73/HISTORICAL_BODY_REVIEW.json')\n+add(P/'PROGRESS.md','PROGRESS.md')\n+files.append({**files[-1],'relative':'evidence/geo300-capacity512-20261024/PROGRESS.md'})\n+assert len({x['relative']for x in files})==len(files)\n+report={'status':'UNBOUND; archive preloads and actual publication budget not yet bound',\n+ 'source_sha':'73b21e64dce72f0d16ca29e18559c51815b9724d','old_body_sha':'9cca9a4d7ea5992366c8ef5df7ef639a455544c7',\n+ 'body_template_sha256':hashlib.sha256((P/'PR_BODY.template.md').read_bytes()).hexdigest(),\n+ 'files':files,'payload_bytes':sum(x['bytes']for x in files),\n+ 'archive_bytes':sum(x['bytes']for x in files if x['archive_preload_required']),\n+ 'nonarchive_bytes':sum(x['bytes']for x in files if not x['archive_preload_required']),\n+ 'limits':['No Git object/ref/index or archive body read in this preparation.','Both archive known pins come from completed independent full original roundtrips and must be revalidated by actual preload and final publisher.','Formal100MiB guard and600-second test timeouts unchanged.']}\n+(P/'FILE_ALLOWLIST_UNBOUND.json').write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\\n')\n+print(json.dumps({k:v for k,v in report.items()if k!='files'},ensure_ascii=False))"},{"sha":"8efd5567a4732d66230cfa9a1f746f2543d48273","filename":"evidence/geo300-capacity512-20261024/formal-F73b21e64/publish_bound.py","status":"added","additions":92,"deletions":0,"changes":92,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fpublish_bound.py","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fpublish_bound.py","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fpublish_bound.py?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f","patch":"@@ -0,0 +1,92 @@\n+\"\"\"Draft only until READY_MANIFEST is frozen after the exclusive performance run.\n+\n+Reuse the existing owner repository/index and the existing body branch parent.\n+Keep archives in their original paths; hash-object reads them directly, so the\n+recorder never writes another full archive into a stdin/stdout capture.\n+\"\"\"\n+from pathlib import Path\n+import datetime,hashlib,json,os,shutil,subprocess,sys,traceback\n+HERE=Path(__file__).resolve().parent;ROOT=Path('/workspace/geo300-capacity512-work-20261024')\n+OUT=Path('/tmp/geo348-F73-evidence-publication-20261024');BR='codex/geo300-capacity512-20261024';DBR=BR+'-prbody'\n+S='73b21e64dce72f0d16ca29e18559c51815b9724d';OLD_D='9cca9a4d7ea5992366c8ef5df7ef639a455544c7'\n+PREFIX='evidence/geo300-capacity512-20261024/formal-F73b21e64/'\n+PROGRESS='evidence/geo300-capacity512-20261024/PROGRESS.md'\n+READY_MANIFEST_SHA256='32aa455dd8a65d1f6aa8c2027ffd5a3ded166439969c97104046578c7d0f9ba2'\n+report={'source_sha':S,'branch':BR,'body_branch':DBR,'old_body_sha':OLD_D,'evidence_pushed':False,'body_pushed':False,'evidence_sha':None,'body_sha':None,'commands':[],'exit':None}\n+def sha(b):return hashlib.sha256(b).hexdigest()\n+def need(v,m):\n+ if not v:raise RuntimeError(m)\n+def dump(p,x):p.write_text(json.dumps(x,ensure_ascii=False,indent=2)+'\\n')\n+def git(*args,data=None):\n+ env={k:v for k,v in os.environ.items()if not k.startswith('GIT_')};argv=['git','-c','gc.auto=0','-c','maintenance.auto=false',*args]\n+ start=datetime.datetime.now(datetime.timezone.utc).isoformat();r=subprocess.run(argv,cwd=ROOT,input=data,capture_output=True,env=env)\n+ d=OUT/'commands'/f'{len(report[\"commands\"])+1:03d}';d.mkdir(parents=True);(d/'stdout').write_bytes(r.stdout);(d/'stderr').write_bytes(r.stderr)\n+ row={'argv':argv,'cwd':str(ROOT),'started_utc':start,'actual_exit':r.returncode,'stdout_sha256':sha(r.stdout),'stderr_sha256':sha(r.stderr)}\n+ if data is not None:(d/'stdin').write_bytes(data);row['stdin_sha256']=sha(data)\n+ dump(d/'result.json',row);report['commands'].append(row);need(r.returncode==0,'original Git failure '+str(d));return r.stdout\n+def main():\n+ need(READY_MANIFEST_SHA256!='UNBOUND_DO_NOT_EXECUTE','Draft is not authorized for runtime; freeze reviewed manifest after R6')\n+ path=HERE/'READY_MANIFEST.json';need(sha(path.read_bytes())==READY_MANIFEST_SHA256,'frozen publication allowlist/pins');m=json.loads(path.read_bytes())\n+ need(m['source_sha']==S and m['old_body_sha']==OLD_D,'fixed original source/body')\n+ need(not OUT.exists(),'fresh publication output');OUT.mkdir()\n+ try:\n+  actual_payload=sum(Path(item['local']).stat().st_size for item in m['files'])\n+  need(actual_payload==sum(item['bytes']for item in m['files'])==m['payload_bytes'],'actual allowlist bytes match frozen payload budget')\n+  free=shutil.disk_usage(ROOT).free;report.update(free_before=free,payload_bytes=m['payload_bytes'],actual_payload_bytes=actual_payload,publication_min_free_bytes=m['publication_min_free_bytes'])\n+  need(free>=m['publication_min_free_bytes'],'publication budget only; formal100MiB unchanged')\n+  preloads=m['preloaded_archives'];need(len(preloads)==2,'two exact original archives preloaded')\n+  need(sha(Path(m['permanent_store_lease']['path']).read_bytes())==m['permanent_store_lease']['sha256'],'permanent Git object store lease unchanged')\n+  need(sha(Path(m['root_alternates']['path']).read_bytes())==m['root_alternates']['sha256'],'root ordinary-reader alternate unchanged')\n+  need({x['relative']for x in m['files']if x['archive_preload_required']}==set(preloads),'preloads match exact two archive leaves')\n+  need(git('rev-parse','HEAD').decode().strip()==S,'fixed clean source');need(git('symbolic-ref','--short','HEAD').decode().strip()==BR,'only owned branch')\n+  need(git('status','--porcelain=v1','--untracked-files=all')==b'','clean original source');need(not(ROOT/'.git/index.lock').exists(),'no concurrent source index writer')\n+  need(git('ls-remote','--heads','origin','refs/heads/'+BR).decode().split()==[S,'refs/heads/'+BR],'original source resolves')\n+  need(git('ls-remote','--heads','origin','refs/heads/'+DBR).decode().split()==[OLD_D,'refs/heads/'+DBR],'original body resolves')\n+  need(git('rev-parse','refs/heads/'+DBR).decode().strip()==OLD_D,'local body exact parent')\n+  rows=[];allow=[];oids={}\n+  for item in m['files']:\n+   rel=item['relative'];p=Path(item['local']);need((rel==PROGRESS or rel.startswith(PREFIX))and '..'not in Path(rel).parts,'owned exact prefix')\n+   need(p.is_file()and not p.is_symlink(),'regular original evidence');need(p.stat().st_size==item['bytes']and sha(p.read_bytes())==item['sha256'],'unchanged original bytes '+rel)\n+   if item['archive_preload_required']:\n+    pre=preloads[rel];need(pre['bytes']==item['bytes'] and pre['sha256']==item['sha256'],'preload exact original archive identity')\n+    need(git('cat-file','-t',pre['oid'])==b'blob\\n' and git('cat-file','-s',pre['oid'])==(str(item['bytes'])+'\\n').encode(),'ordinary fifth-hop reader resolves preloaded blob')\n+    primary=ROOT/'.git/objects'/pre['oid'][:2]/pre['oid'][2:];need(not primary.exists(),'no primary duplicate before default writer')\n+   oid=git('hash-object','-w','--no-filters','--',str(p)).strip()\n+   if item['archive_preload_required']:\n+    need(oid.decode()==pre['oid'] and not primary.exists(),'default writer reuses alternate blob without primary copy')\n+   oids[rel]=oid;rows.append(b'100644 '+oid+b'\\t'+rel.encode()+b'\\0');allow.append(rel)\n+  # The externally pinned manifest does not hash itself or its bound publisher.\n+  # Publish both as two explicit additional metadata leaves after validation.\n+  for local,name in [(path,'PUBLICATION_MANIFEST.json'),(Path(__file__),'publish_bound.py')]:\n+   rel=PREFIX+name;oid=git('hash-object','-w','--no-filters','--',str(local)).strip()\n+   oids[rel]=oid;rows.append(b'100644 '+oid+b'\\t'+rel.encode()+b'\\0');allow.append(rel)\n+  need(len(allow)==len(set(allow)),'unique publication paths')\n+  git('update-index','-z','--index-info',data=b''.join(rows));git('update-index','--skip-worktree','-z','--stdin',data=b''.join(x.encode()+b'\\0'for x in allow))\n+  need(set(git('diff','--cached','--name-only','-z').rstrip(b'\\0').decode().split('\\0'))==set(allow),'only explicit evidence/progress changed; prior receipts preserved')\n+  git('diff','--cached','--check')\n+  for rel,oid in oids.items():need(git('rev-parse',':'+rel).strip()==oid,'staged original blob '+rel)\n+  git('commit','-m','Record capacity512 original failures and safe sentinel validation')\n+  E=git('rev-parse','HEAD').decode().strip();report['evidence_sha']=E\n+  need(git('show','-s','--format=%P',E).decode().strip()==S,'ordinary evidence parent')\n+  need(set(git('diff','--name-only','-z',S,E).rstrip(b'\\0').decode().split('\\0'))==set(allow),'evidence-only commit')\n+  for rel,oid in oids.items():need(git('rev-parse',E+':'+rel).strip()==oid,'committed original blob '+rel)\n+  git('push','origin','refs/heads/'+BR+':refs/heads/'+BR)\n+  need(git('ls-remote','--heads','origin','refs/heads/'+BR).decode().split()==[E,'refs/heads/'+BR],'public evidence exact');report['evidence_pushed']=True\n+  template=(HERE/'PR_BODY.template.md').read_bytes();need(sha(template)==m['body_template_sha256']and template.count(b'__EVIDENCE_HEAD__')==1,'accepted single evidence placeholder')\n+  body=template.replace(b'__EVIDENCE_HEAD__',E.encode());(OUT/'PR_BODY.md').write_bytes(body)\n+  before_index=sha((ROOT/'.git/index').read_bytes());tree={}\n+  for row in git('ls-tree','-z',OLD_D).rstrip(b'\\0').split(b'\\0'):\n+   meta,name=row.split(b'\\t',1);tree[name]=meta\n+  oid=git('hash-object','-w','--stdin',data=body).strip();tree[b'PR_BODY.md']=b'100644 blob '+oid\n+  tree_id=git('mktree','-z',data=b''.join(meta+b'\\t'+name+b'\\0'for name,meta in sorted(tree.items()))).strip()\n+  D=git('commit-tree',tree_id.decode(),'-p',OLD_D,data=b'Describe capacity512 targeted validation and remaining placed timeouts\\n').decode().strip();report['body_sha']=D\n+  need(git('show','-s','--format=%P',D).decode().strip()==OLD_D,'ordinary existing body parent');need(git('diff','--name-only','-z',OLD_D,D)==b'PR_BODY.md\\0','only body changed')\n+  need(git('show',D+':PR_BODY.md')==body,'exact published body bytes')\n+  git('update-ref','refs/heads/'+DBR,D,OLD_D);git('push','origin','refs/heads/'+DBR+':refs/heads/'+DBR)\n+  need(git('ls-remote','--heads','origin','refs/heads/'+DBR).decode().split()==[D,'refs/heads/'+DBR],'public body exact');report['body_pushed']=True\n+  need(sha((ROOT/'.git/index').read_bytes())==before_index,'body publication preserves source index');need(git('status','--porcelain=v1','--untracked-files=all')==b'','source clean after publication')\n+  report['exit']=0\n+ except BaseException:report.update(exit=1,error=traceback.format_exc())\n+ finally:dump(OUT/'RESULT.json',report);print(json.dumps({k:report.get(k)for k in ['evidence_sha','body_sha','evidence_pushed','body_pushed','exit','error']}),flush=True)\n+ return report['exit']\n+if __name__=='__main__':sys.exit(main())"},{"sha":"f0f5ac13894e982204208c2f437a3aa3fe13ba3f","filename":"evidence/geo300-capacity512-20261024/formal-F73b21e64/storage-preload/EXEC_COMPLETION.json","status":"added","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fstorage-preload%2FEXEC_COMPLETION.json","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fstorage-preload%2FEXEC_COMPLETION.json","contents_url":"https://api.github.com/repos/ZhiQiYang/geometry-axiom/contents/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fstorage-preload%2FEXEC_COMPLETION.json?ref=9a8584f57be7935604c3bad4c2481945a6ec3d9f","patch":"@@ -0,0 +1,7 @@\n+{\n+  \"chunk_id\": \"f73059\",\n+  \"wall_time_seconds\": 0.000020657,\n+  \"exit_code\": 0,\n+  \"original_token_count\": 0,\n+  \"output\": \"\"\n+}"},{"sha":"35463fcb6205793a160bbd54c71b11534b15a4ba","filename":"evidence/geo300-capacity512-20261024/formal-F73b21e64/storage-preload/EXEC_LAUNCH.json","status":"added","additions":7,"deletions":0,"changes":7,"blob_url":"https://github.com/ZhiQiYang/geometry-axiom/blob/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo300-capacity512-20261024%2Fformal-F73b21e64%2Fstorage-preload%2FEXEC_LAUNCH.json","raw_url":"https://github.com/ZhiQiYang/geometry-axiom/raw/9a8584f57be7935604c3bad4c2481945a6ec3d9f/evidence%2Fgeo3