+async function recordHistory(route,phase,description){
+  // The impact dialog can close before the App replaces its inspector DOM.
+  // Reacquire visible locators after that redraw, then open the native disclosure.
+  await p.locator('dialog.reference-impact[open]').waitFor({state:'hidden'});
+  for(let i=0;i<4;i++) {
+    await pause(180);
+    await openParents('#refRoomStatus');
+    const readback=await snapshot();
+    if(readback.statusVisible&&readback.reviewVisible)break;
+    if(!readback.reviewVisible)await p.locator('#refOutlineDetails [data-reconstruction-state] > p').click({timeout:2000}).catch(()=>{});
+  }
+  const state=await step(phase+'-result',description);
+  const assertions=checks(route,phase,state);
+  r.history.push({route,phase,file:r.steps.at(-1).file,assertions,state});
+  for(const [name,ok] of Object.entries(assertions))
+    r.assertions.push({label:route+' '+phase+' '+name,pass:!!ok});
+  return state;
+}
