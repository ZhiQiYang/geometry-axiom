+static void contact_plane_maximum_insert(ContactFaceIndex *index,const WoodStopFace *out,size_t face)
+{
+    size_t *value=&index->maximum[index->rank[face]];
+    if(!*value||out[*value-1].hi<out[face].hi||
+       (out[*value-1].hi==out[face].hi&&out[*value-1].lo>out[face].lo))*value=face+1;
+}
+static bool contact_plane_maximum_dedup(const WoodContactWorld *world,const ContactOrderIndex *orders,
+    WoodStopFace *out,size_t count,size_t first,const uint64_t *order,
+    ContactFaceIndex *index,bool *active,size_t *remaining)
+{
+    /* A plane's largest hi is a sufficient witness only when that same real
+     * face also covers lo. Regular rows of timbers usually satisfy this;
+     * an ambiguous witness falls back to the complete prefix index below.
+     * Small queries avoid this setup. Bound both load and collision work so
+     * the speculative path adds O(F), even for adversarial coordinates. */
+    if(count<32||count>WOOD_CONTACT_FACE_CAPACITY/2)return false;
+    size_t slots=count*2,probes=0;
+    memset(index->sorted,0,slots*sizeof *index->sorted);
+    memset(index->maximum,0,slots*sizeof *index->maximum);
+    for(size_t i=0;i<count;++i){
+        if(out[i].lo>=out[i].hi)return false;
+        uint64_t key=(uint64_t)out[i].fixed;
+        key^=key>>33;key*=UINT64_C(0xff51afd7ed558ccd);key^=key>>33;
+        size_t slot=(size_t)(key%slots);
+        while(index->sorted[slot]&&out[index->sorted[slot]-1].fixed!=out[i].fixed){
+            if(++probes>count*8)return false;
+            slot=(slot+1)%slots;
+        }
+        if(!index->sorted[slot])index->sorted[slot]=i+1;
+        index->rank[i]=slot;index->scratch[i]=1;
+    }
+    for(size_t i=0;i<first;++i)contact_plane_maximum_insert(index,out,i);
+    size_t pending=first,survivors=*remaining;
+    for(size_t i=first;i<count;++i){
+        while(pending<i&&contact_earlier(world,orders,out[pending].timber_id,order[i])){
+            if(index->scratch[pending])contact_plane_maximum_insert(index,out,pending);++pending;
+        }
+        size_t witness=index->maximum[index->rank[i]];
+        if(witness&&contact_prefix_hi(out[witness-1].hi,&out[i])){
+            if(!contact_prefix_lo(out[witness-1].lo,&out[i]))return false;
+            index->scratch[i]=0;--survivors;
+        }
+    }
+    /* No deletion becomes visible until the entire query succeeds. A late
+     * ambiguous face therefore cannot corrupt the original fallback. */
+    for(size_t i=first;i<count;++i)active[i]=index->scratch[i]!=0;
+    *remaining=survivors;
+    return true;
+}
