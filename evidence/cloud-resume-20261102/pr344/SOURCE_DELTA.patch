diff --git a/.github/scripts/architecture_evidence.py b/.github/scripts/architecture_evidence.py
new file mode 100644
index 00000000..4b456e67
--- /dev/null
+++ b/.github/scripts/architecture_evidence.py
@@ -0,0 +1,99 @@
+"""在 CI 記錄原架構三命令，產出新來源的衍生資料；不改 scanner。"""
+import argparse
+from collections import Counter
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parents[2]
+MANIFEST = "geometry-core/domain-decoupling/product-architecture.json"
+MAIN = "8f82b207e87c086705a1d8b7a00e2f215c07cbcf"
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def save(path, value):
+    path.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+
+
+def run(out):
+    out.mkdir(parents=True, exist_ok=False)
+    head = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
+    subprocess.run(["git", "diff", "--quiet", "HEAD"], cwd=ROOT, check=True)
+    commands = [
+        ("architecture-cli", [sys.executable, "-B", "tests/architecture_contract.py", "--root", ".", "--manifest", MANIFEST]),
+        ("architecture-unit", [sys.executable, "-B", "tests/test_architecture_contract.py"]),
+        ("architecture-product", [sys.executable, "-B", "tests/test_product_architecture.py"]),
+    ]
+    receipt = {"schema": "geometry-architecture-ci-receipt/1", "sourceHead": head,
+               "adoptedMain": MAIN, "runId": os.environ.get("GITHUB_RUN_ID"),
+               "runAttempt": os.environ.get("GITHUB_RUN_ATTEMPT"), "complete": False, "commands": []}
+    for label, command in commands:
+        stdout, stderr = out / (label + ".stdout"), out / (label + ".stderr")
+        with stdout.open("wb") as output, stderr.open("wb") as errors:
+            process = subprocess.run(command, cwd=ROOT, stdout=output, stderr=errors)
+        raw_out, raw_err = stdout.read_bytes(), stderr.read_bytes()
+        print(raw_out.decode("utf-8", errors="replace"), end="", flush=True)
+        print(raw_err.decode("utf-8", errors="replace"), end="", file=sys.stderr, flush=True)
+        row = {"label": label, "command": ["<python>", *command[1:]], "cwd": "<repo>",
+               "exitCode": process.returncode, "stdout": stdout.name, "stderr": stderr.name,
+               "stdoutSha256": digest(raw_out), "stderrSha256": digest(raw_err)}
+        if label != "architecture-cli":
+            match = re.search(rb"Ran (\d+) tests? in ", raw_err)
+            if match is None or int(match[1]) == 0 or re.search(rb"\bskipped=[1-9]\d*", raw_err):
+                row["completenessProblem"] = "未找到完整非零 unittest 計數，或含 skip"
+            else:
+                row["testsRun"] = int(match[1])
+        receipt["commands"].append(row)
+        save(out / "product-architecture-receipt.json", receipt)
+        if process.returncode != 0 or "completenessProblem" in row:
+            raise RuntimeError("原架構命令未完整通過：" + label)
+
+    scan_bytes = (out / "architecture-cli.stdout").read_bytes()
+    subprocess.run(["git", "diff", "--quiet", "HEAD"], cwd=ROOT, check=True)
+    scan = json.loads(scan_bytes)
+    if scan.get("ok") is not True or scan.get("diagnostics") != []:
+        raise RuntimeError("原 scanner 未回報零 diagnostics")
+    (out / "product-architecture-scan.json").write_bytes(scan_bytes)
+    manifest_bytes = (ROOT / MANIFEST).read_bytes().replace(b"\r\n", b"\n")
+    manifest = json.loads(manifest_bytes)
+    inputs = []
+    for entry in manifest["sources"] + manifest["exclusions"]:
+        path = entry["path"]
+        inputs.append({"path": path, "lfSha256": digest((ROOT / path).read_bytes().replace(b"\r\n", b"\n"))})
+    inputs.sort(key=lambda entry: entry["path"])
+    receipt.update({"complete": True, "manifestLfSha256": digest(manifest_bytes),
+                    "scannerLfSha256": digest((ROOT / "tests/architecture_contract.py").read_bytes().replace(b"\r\n", b"\n")),
+                    "testScriptsLfSha256": {command[2]: digest((ROOT / command[2]).read_bytes().replace(b"\r\n", b"\n"))
+                                            for _, command in commands[1:]},
+                    "scanSha256": digest(scan_bytes), "ownedCount": len(manifest["sources"]),
+                    "exclusionCount": len(manifest["exclusions"]), "edgeCount": len(scan["edges"]),
+                    "diagnosticCount": 0, "inputs": inputs,
+                    "inputLfClosureSha256": digest("\n".join(entry["path"] + " " + entry["lfSha256"] for entry in inputs).encode("utf-8"))})
+    save(out / "product-architecture-receipt.json", receipt)
+    layers = Counter(entry["layer"] for entry in manifest["sources"])
+    rows = "\n".join("| " + layer + " | " + str(count) + " |" for layer, count in sorted(layers.items()))
+    tests = "、".join(row["label"] + "=" + str(row["testsRun"]) for row in receipt["commands"] if "testsRun" in row)
+    report = (
+        "# Product architecture — GitHub 新來源收據\n\n"
+        f"來源 `{head}`；採入 main `{MAIN}`；Actions run `{receipt['runId']}`。\n\n"
+        "這份衍生資料來自原 scanner CLI 與原兩支 unittest 的實際執行；三命令均 exit 0、零 skip。"
+        "它只證明靜態依賴契約，不能替代演算法責任審查、原生／突變／瀏覽器或 SSOT 驗證。\n\n"
+        f"本次 {len(inputs)} inputs、{receipt['ownedCount']} owned、{receipt['exclusionCount']} exclusions、"
+        f"{receipt['edgeCount']} edges、0 diagnostics；{tests}。完整命令、原始輸出與雜湊在同 artifact。\n\n"
+        "| Layer | Sources |\n|---|---:|\n" + rows + "\n\n"
+        f"main 的歷史收據保留在 Git `{MAIN}`，本次沒有改寫其來源或沿用其綠燈。\n"
+    )
+    (out / "PRODUCT-ARCHITECTURE.md").write_text(report, encoding="utf-8")
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    run(parser.parse_args().out.resolve())
diff --git a/.github/scripts/mutation_evidence.py b/.github/scripts/mutation_evidence.py
new file mode 100644
index 00000000..a64122c1
--- /dev/null
+++ b/.github/scripts/mutation_evidence.py
@@ -0,0 +1,266 @@
+"""CI supervisor for the unchanged, strict mutation runner and its artifacts."""
+import argparse
+import contextlib
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tarfile
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "tests"))
+import mutate as mt
+
+
+def sha(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def supervisor_sha():
+    return hashlib.sha256(Path(__file__).read_bytes().replace(b"\r\n", b"\n")).hexdigest()
+
+
+def read_json(path):
+    def unique(pairs):
+        result = {}
+        for key, value in pairs:
+            if key in result:
+                raise ValueError("duplicate JSON key: " + key)
+            result[key] = value
+        return result
+    return json.loads(path.read_text(encoding="utf-8"), object_pairs_hook=unique)
+
+
+def write_json(path, value):
+    path.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+
+
+def head():
+    return subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
+
+
+def shards():
+    result = {}
+    for kind, count in (("core", 4), ("bridge", 3)):
+        items = [m for m in mt.MUTANTS if (m.get("binary") == "bridge") == (kind == "bridge")]
+        for index in range(count):
+            result[f"{kind}-{index + 1}"] = [m["id"] for m in items[index::count]]
+    flat = [rid for ids in result.values() for rid in ids]
+    assert len(flat) == len(set(flat)) == len(mt.MUTANTS)
+    assert set(flat) == {m["id"] for m in mt.MUTANTS}
+    return result
+
+
+def selected(ids):
+    return [m for m in mt.MUTANTS if m["id"] in ids]
+
+
+def require_binaries(mutants, records, cache):
+    """Unlike --check alone, artifact verification requires every executed binary."""
+    sources = mt.Sources(ROOT)
+    for mutant in mutants:
+        record = records[mutant["id"]]
+        if record["verdict"] == "retired":
+            continue
+        execution = record["execution"]
+        if mutant.get("binary") == "bridge":
+            binary = "bridge.exe" if execution["platform"] == "nt" else "bridge"
+            baseline = cache / "_bridge-baseline" / execution["head"]
+            folder = cache / mutant["id"]
+            paths = [
+                (baseline / binary, execution["baseline_identity"]),
+                (folder / "bridge-mutant" / binary, execution["mutant_identity"]),
+                (folder / "bridge-restored" / binary, execution["restored_identity"]),
+            ]
+            trials = execution.get("mutant_attempts") or [execution["mutant"]]
+            raw = [(baseline, execution["baseline_build"]), (baseline, execution["baseline"]),
+                   (folder, execution["mutant_build"]), (folder, execution["restored_build"]),
+                   (folder, execution["restored"]), *[(folder, trial) for trial in trials]]
+            for directory, receipt in raw:
+                for stream in ("stdout", "stderr"):
+                    path = directory / receipt[stream + "_file"]
+                    if not path.is_file() or sha(path) != receipt[stream + "_sha256"]:
+                        raise ValueError("missing or changed bridge raw output: " + str(path))
+        else:
+            paths = [
+                (cache / mutant["id"] / "_mut.exe", {
+                    "exe_sha256": execution["exe_sha256"],
+                    "fingerprint": mt.mutant_fingerprint(mutant, sources, execution["compile_sha256"])}),
+                (cache / "_baseline" / "baseline.exe", {
+                    "exe_sha256": execution["baseline_exe_sha256"],
+                    "fingerprint": mt.baseline_fingerprint(sources, execution["compile_sha256"])}),
+            ]
+        for path, identity in paths:
+            if not path.is_file() or sha(path) != identity["exe_sha256"]:
+                raise ValueError("missing or changed executed binary: " + str(path))
+            sidecar = path.with_name(path.name + ".fingerprint.json")
+            if not sidecar.is_file():
+                raise ValueError("missing executed binary sidecar: " + str(sidecar))
+            metadata = read_json(sidecar)
+            if mutant.get("binary") == "bridge":
+                if sha(sidecar) != identity["sidecar_sha256"] or metadata != identity["sidecar"]:
+                    raise ValueError("changed official bridge sidecar: " + str(sidecar))
+            elif metadata.get("exe_sha256") != identity["exe_sha256"] or metadata.get("fingerprint") != identity["fingerprint"]:
+                raise ValueError("changed core binary sidecar: " + str(sidecar))
+
+
+def strict_check(mutants, ledger, cache):
+    previous = mt.MUT_ROOT
+    try:
+        mt.MUT_ROOT = cache
+        status = mt.check_pass(mutants, root=ROOT, results_path=ledger, require_execution=True)
+        if status != 0:
+            raise ValueError("strict mutation check failed: " + str(status))
+    finally:
+        mt.MUT_ROOT = previous
+
+
+def negative_probe(mutants, ledger, records, cache):
+    mutant = next(m for m in mutants if records[m["id"]]["verdict"] != "retired")
+    execution = records[mutant["id"]]["execution"]
+    if execution["platform"] != os.name:
+        raise ValueError("negative cache probe must run on the execution platform")
+    bridge = mutant.get("binary") == "bridge"
+    path = (cache / mutant["id"] / "bridge-mutant" / ("bridge.exe" if os.name == "nt" else "bridge")) if bridge else cache / mutant["id"] / "_mut.exe"
+    original = path.read_bytes()
+    previous = mt.MUT_ROOT
+    try:
+        mt.MUT_ROOT = cache
+        path.write_bytes(original + b"\nCI deliberately mismatched cache probe\n")
+        problems = mt.execution_problems(mutant, records[mutant["id"]], records[mutant["id"]]["verdict"], mt.Sources(ROOT))
+        expected = "bridge executable artifact changed" if bridge else "cached binary differs from executed receipt"
+        if not any(expected in problem for problem in problems):
+            raise ValueError("mismatched cache did not fail at the binary guard: " + repr(problems))
+        with contextlib.redirect_stdout(sys.stdout):
+            if mt.check_pass(mutants, root=ROOT, results_path=ledger, require_execution=True) != 1:
+                raise ValueError("mismatched cache did not produce strict exit 1")
+        return {"id": mutant["id"], "expected": expected, "strict_exit": 1}
+    finally:
+        path.write_bytes(original)
+        mt.MUT_ROOT = previous
+
+
+def run_shard(name, out):
+    ids = shards()[name]
+    out.mkdir(parents=True, exist_ok=False)
+    cache, ledger = out / "cache", out / "mutants_results.json"
+    cache.mkdir()
+    subprocess.run(["git", "diff", "--exit-code", "HEAD"], cwd=ROOT, check=True)
+    env = dict(os.environ, MUTATE_CACHE=str(cache), MUTATE_RESULTS=str(ledger), PYTHONUNBUFFERED="1")
+    command = [sys.executable, "tests/mutate.py", *ids]
+    with (out / "execution.log").open("w", encoding="utf-8") as log:
+        process = subprocess.Popen(command, cwd=ROOT, env=env, stdout=subprocess.PIPE,
+                                   stderr=subprocess.STDOUT, text=True, encoding="utf-8")
+        for line in process.stdout:
+            log.write(line)
+            log.flush()
+            print(line, end="", flush=True)
+        status = process.wait()
+    if status != 0:
+        raise ValueError("mutation execution failed: " + str(status))
+    records = read_json(ledger)
+    if set(records) != set(ids):
+        raise ValueError("shard ledger does not cover exactly its assigned IDs")
+    if any(record.get("execution", {}).get("head") != head()
+           for record in records.values() if record["verdict"] != "retired"):
+        raise ValueError("shard contains execution receipts from another head")
+    mutants = selected(ids)
+    require_binaries(mutants, records, cache)
+    strict_check(mutants, ledger, cache)
+    probe = negative_probe(mutants, ledger, records, cache)
+    require_binaries(mutants, records, cache)
+    strict_check(mutants, ledger, cache)
+    archive = out / "cache.tar.gz"
+    def keep(info):
+        # The committed scratch clone and optional OS core dumps are not receipts.
+        if Path(info.name).name == "core" or Path(info.name).name.startswith("core."):
+            return None
+        return info
+    with tarfile.open(archive, "w:gz") as tar:
+        for path in sorted(cache.iterdir()):
+            if path.name != "_bridge-work":
+                tar.add(path, arcname=path.name, filter=keep)
+    write_json(out / "manifest.json", {
+        "schema": "geometry-mutation-ci-shard/1", "head": head(), "shard": name, "ids": ids,
+        "run_id": os.environ.get("GITHUB_RUN_ID"), "run_attempt": os.environ.get("GITHUB_RUN_ATTEMPT"),
+        "platform": os.name, "tool_sha256": mt.tool_hash(), "supervisor_sha256": supervisor_sha(),
+        "ledger_sha256": sha(ledger), "cache_sha256": sha(archive),
+        "execution_log_sha256": sha(out / "execution.log"), "negative_cache_probe": probe,
+        "compiler": subprocess.check_output([os.environ.get("CC", "cc"), "--version"], text=True),
+    })
+
+
+def verify(artifacts, out):
+    out.mkdir(parents=True, exist_ok=False)
+    expected = shards()
+    folders = sorted(path.parent for path in artifacts.glob("*/manifest.json"))
+    if len(folders) != len(expected):
+        raise ValueError("missing or extra shard artifacts")
+    merged, seen, manifests = {}, set(), []
+    for folder in folders:
+        manifest = read_json(folder / "manifest.json")
+        name = manifest["shard"]
+        if name not in expected or name in seen or manifest["ids"] != expected[name]:
+            raise ValueError("unknown, duplicate or changed shard assignment")
+        seen.add(name)
+        if (manifest["schema"] != "geometry-mutation-ci-shard/1" or manifest["head"] != head()
+                or manifest["tool_sha256"] != mt.tool_hash() or manifest["supervisor_sha256"] != supervisor_sha()):
+            raise ValueError("artifact source, runner or supervisor differs from checkout")
+        for filename, field in (("mutants_results.json", "ledger_sha256"), ("cache.tar.gz", "cache_sha256"), ("execution.log", "execution_log_sha256")):
+            if sha(folder / filename) != manifest[field]:
+                raise ValueError("artifact bytes changed: " + filename)
+        records = read_json(folder / "mutants_results.json")
+        if set(records) != set(expected[name]) or set(records) & set(merged):
+            raise ValueError("missing, unknown or duplicate mutation records")
+        if any(record.get("execution", {}).get("head") != head()
+               for record in records.values() if record["verdict"] != "retired"):
+            raise ValueError("artifact contains execution receipts from another head")
+        cache = out / name
+        cache.mkdir()
+        with tarfile.open(folder / "cache.tar.gz", "r:gz") as tar:
+            tar.extractall(cache, filter="data")
+        mutants = selected(expected[name])
+        require_binaries(mutants, records, cache)
+        strict_check(mutants, folder / "mutants_results.json", cache)
+        merged.update(records)
+        manifests.append(manifest)
+    if seen != set(expected) or set(merged) != {m["id"] for m in mt.MUTANTS}:
+        raise ValueError("aggregate is not the complete current mutation table")
+    ledger = out / "mutants_results.json"
+    write_json(ledger, merged)
+    # Full-table source/closure/mutant/oracle/receipt validation is separate from
+    # the required, byte-exact artifact checks performed for every shard above.
+    strict_check(mt.MUTANTS, ledger, out / "no-local-binaries")
+    previous = mt.MUT_ROOT
+    try:
+        mt.MUT_ROOT = out / "no-local-binaries"
+        table = mt.evaluate_table(mt.MUTANTS, merged, mt.Sources(ROOT), "", mt.oracle_hash(), require_execution=True)
+    finally:
+        mt.MUT_ROOT = previous
+    write_json(out / "summary.json", {
+        "schema": "geometry-mutation-ci-summary/1", "head": head(), "table_size": len(mt.MUTANTS),
+        "active": sum(record["verdict"] != "retired" for record in merged.values()),
+        "counts": mt.tally(table), "ledger_sha256": sha(ledger), "shards": manifests,
+        "binary_bytes_verified": True, "full_table_strict_exit": 0,
+    })
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("mode", choices=("plan", "run", "verify"))
+    parser.add_argument("--shard")
+    parser.add_argument("--out", type=Path)
+    parser.add_argument("--artifacts", type=Path)
+    args = parser.parse_args()
+    if args.mode == "plan":
+        print("matrix=" + json.dumps({"include": [{"shard": name} for name in shards()]}))
+    elif args.mode == "run":
+        run_shard(args.shard, args.out.resolve())
+    else:
+        verify(args.artifacts.resolve(), args.out.resolve())
+
+
+if __name__ == "__main__":
+    main()
