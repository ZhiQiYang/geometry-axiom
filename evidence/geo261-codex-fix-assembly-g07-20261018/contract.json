{
  "schema": "geo261-topic14-browser-contract/1",
  "contract_id": "topic14-g07-diagnostic-only-v1",
  "baseline_sha": "e64aa6359d600f43313ec9d7ba1112c465b6a40c",
  "scope": "只允許 topic14 diagnostic-only assembly job；不是13+14 C1整合契約或產品修正",
  "target_binding": "--expected-sha 必須為實際乾淨 HEAD 的完整40位commit；此固定bytes契約與該SHA共同寫入每次preflight，不從目標學習pin。",
  "review_manifest_sha256": "ec599c139059c3d5747187ceac833fef9d18272aca0fe49b49a28bea46a25f10",
  "baseline_contract_sha256": "e587f5e4717b6b8fa743fc638b8939202a67d91643d00725a08389b43941d277",
  "baseline_runner_sha256": "800f680e17e55d20599fa3e3cff184ea172973bbee26104d01e59bc8bebf576f",
  "c1_wrapper_sha256": "5be392c987d198940c0fa6496cdb975072dfb3754542c0d13cd38214b05da6c6",
  "patch": {
    "path": "proposed-fixes/14-assembly-g07-diagnostic-only.patch",
    "sha256": "c0f135d9bcfaf21d21309b6ae9e7823d1ba6e0d08e290e8b8ae613d1af28bc31"
  },
  "workflow": {
    "path": ".github/workflows/integration-tests.yml",
    "baseline_sha256": "3815c1cd50016a4299b46d8f46f458282692b7234e8d819ac6ca44f0298ca4ad",
    "browser_job": {
      "name": "browser (${{ matrix.suite }})",
      "runs-on": "ubuntu-latest",
      "timeout-minutes": "${{ matrix.timeout }}",
      "strategy": {
        "fail-fast": false,
        "max-parallel": 2,
        "matrix": {
          "include": [
            {
              "suite": "assembly",
              "timeout": 15
            },
            {
              "suite": "documents",
              "timeout": 10
            },
            {
              "suite": "grid",
              "timeout": 15
            },
            {
              "suite": "canvas",
              "timeout": 35
            },
            {
              "suite": "space",
              "timeout": 15
            },
            {
              "suite": "timber",
              "timeout": 20
            }
          ]
        }
      },
      "env": {
        "GEOMETRY_TEST_URL": "http://127.0.0.1:18839/",
        "GEOMETRY_FEEDBACK_DIR": "/tmp/geometry-integration-feedback",
        "GEOMETRY_CHROME": "/usr/bin/google-chrome",
        "GEOMETRY_CHROME_FLAGS": "--no-sandbox",
        "GEOMETRY_BROWSER_SUITE": "${{ matrix.suite }}",
        "GEOMETRY_GRID_SYSTEM_SCREENSHOT_DIR": "/tmp/geometry-grid-screens",
        "GEOMETRY_DOCUMENT_SCREENSHOT_DIR": "/tmp/geometry-document-screens"
      },
      "steps": [
        {
          "uses": "actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683",
          "with": {
            "persist-credentials": false
          }
        },
        {
          "name": "Build current native executables",
          "run": "npm run build"
        },
        {
          "name": "Install Chinese fonts for visual verification",
          "run": "sudo apt-get -o Acquire::Retries=2 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 update\nsudo apt-get -o Acquire::Retries=2 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 install -y --no-install-recommends fonts-noto-cjk\n"
        },
        {
          "name": "Run actual browser regression group",
          "shell": "bash",
          "run": "ulimit -s 16384\ntest -x \"$GEOMETRY_CHROME\"\n# WSL canvas wait trace\n# Clear inherited flags for all other jobs.\nunset GEOMETRY_WAIT_TRACE\nunset GEOMETRY_WAIT_TRACE_RUN_ID\ncase \"$GEOMETRY_BROWSER_SUITE:$(uname -r)\" in\n  canvas:*[Mm]icrosoft*) export GEOMETRY_WAIT_TRACE=1 ;;\nesac\nif [ \"${GEOMETRY_WAIT_TRACE-}\" = 1 ]; then\n  export GEOMETRY_WAIT_TRACE_RUN_ID=\"$(python3 geometry-web/prepare_wait_trace.py)\"\nfi\nif [ -n \"${GITHUB_ENV-}\" ]; then\n  printf 'GEOMETRY_WAIT_TRACE=%s\\n' \"${GEOMETRY_WAIT_TRACE-}\" >> \"$GITHUB_ENV\"\nfi\npython3 -u geometry-web/start_local.py --port 18839 > /tmp/geometry-integration-server.log 2>&1 &\nserver=$!\ncleanup() {\n  original_status=$?\n  set +e\n  kill \"$server\" 2>/dev/null || true\n  wait \"$server\" 2>/dev/null || true\n  if [ \"$GEOMETRY_BROWSER_SUITE\" = canvas ]; then\n    python3 geometry-web/archive_wait_trace.py /tmp/geometry-wait-trace-artifact\n    archive_status=$?\n    if [ \"$original_status\" -eq 0 ] && [ \"$archive_status\" -ne 0 ]; then original_status=$archive_status; fi\n  fi\n  exit \"$original_status\"\n}\ntrap cleanup EXIT\nfor attempt in $(seq 1 30); do\n  if ! kill -0 \"$server\" 2>/dev/null; then\n    cat /tmp/geometry-integration-server.log\n    exit 1\n  fi\n  if python3 geometry-web/runtime_version.py --probe 18839 > /dev/null 2>&1; then break; fi\n  sleep 1\ndone\npython3 geometry-web/runtime_version.py --probe 18839\n# Independent matrix jobs expose each result promptly. They use\n# separate runners/servers and do not cancel siblings on failure.\n# The full canvas run retains its strict golden comparison.\nset +e\ncase \"$GEOMETRY_BROWSER_SUITE\" in\n  assembly) GEOMETRY_CDP_PORT=9367 GEOMETRY_ASSEMBLY_ONLY=1 node geometry-web/cdp_test.js ;;\n  grid) GEOMETRY_CDP_PORT=9334 GEOMETRY_GRID_SYSTEM_ONLY=1 node geometry-web/cdp_test.js ;;\n  canvas) node geometry-web/cdp_test.js ;;\n  space) GEOMETRY_CDP_PORT=9347 node geometry-web/space_model_test.js ;;\n  timber) GEOMETRY_CDP_PORT=9348 GEOMETRY_TIMBER_ONLY=1 node geometry-web/space_model_test.js ;;\n  documents) GEOMETRY_CDP_PORT=9366 node geometry-web/documents_browser_test.js ;;\n  *) echo \"Unknown browser suite\"; exit 2 ;;\nesac\nstatus=$?\ncat /tmp/geometry-integration-server.log\nexit \"$status\"\n"
        },
        {
          "name": "Preserve canvas wait trace",
          "if": "always() && matrix.suite == 'canvas'",
          "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
          "with": {
            "name": "canvas-wait-trace",
            "path": "/tmp/geometry-wait-trace-artifact/",
            "if-no-files-found": "error",
            "retention-days": 7
          }
        },
        {
          "name": "Preserve assembly authoring screenshots",
          "if": "always() && matrix.suite == 'assembly'",
          "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
          "with": {
            "name": "assembly-review-screens",
            "path": "/tmp/geometry-tests/assembly-*.png",
            "if-no-files-found": "ignore",
            "retention-days": 7
          }
        },
        {
          "name": "Preserve grid trial screenshots",
          "if": "always() && (matrix.suite == 'grid' || matrix.suite == 'canvas')",
          "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
          "with": {
            "name": "grid-trial-screens-${{ matrix.suite }}",
            "path": "/tmp/geometry-grid-screens/grid-trial-*.png",
            "if-no-files-found": "ignore",
            "retention-days": 7
          }
        },
        {
          "name": "Preserve document reader screenshots",
          "if": "always() && matrix.suite == 'documents'",
          "uses": "actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02",
          "with": {
            "name": "document-reader-screens",
            "path": "/tmp/geometry-document-screens/*.png",
            "if-no-files-found": "ignore",
            "retention-days": 7
          }
        }
      ]
    },
    "policy": "完整browser job YAML語意全等；target整份workflow raw hash逐次保存，native job差異不自動批准browser差異"
  },
