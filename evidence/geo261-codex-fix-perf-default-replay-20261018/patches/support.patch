-        if (!apply_scene_line("default",(int)i+1,tokens,n,world)) return false;
+        bool ok=frame?app_default_replay_line("default",(int)i+1,tokens,n,world,i):apply_scene_line("default",(int)i+1,tokens,n,world);
+        if(!ok)return false;
     }
