 },
 "M23": {
  "desc": "R6(d)：擋面歧義放行(hits>1 不拒絕)",
  "verdict": "equivalent",
  "why": "等價變異(GEO-172 實證):hits>1 需要兩個邊類擋面在同一座標且都涵蓋角材全寬。輪廓邊+孔邊 → 孔要貼輪廓,核心拒絕;兩孔共邊/共角 → 核心拒絕(兩孔分開才接受);任一為角材側面 → stop_face_shadowed 只留一個;同一簡單多邊形不可能兩邊同座標又涵蓋同段。該分支在合法輸入下不可達,改掉不改變行為。",
  "date": "2026-10-21",
  "source_file": "geometry-templates/woodworking/native/member_reference.c",
  "source_sha256": "90f3316777c181f3491ff01b4a06b6f3139f120452e74bbf02d78a323c6c024f",
  "closure_sha256": "dff8a902e49aa2ed96c1981870e2739163c5f18076a3e9e3fed121d79103292f",
  "oracle_sha256": "f8222a4ac7ae76339cfb7536634f98e572ecd2bb0d649ce3395d6d452e2fa306",
  "mutant_sha256": "e8e9399d304555b1c5d9d8dd0829db64c102d3640b329bb2668616e76441593b",
  "execution": {
   "schema": "geometry-mutation-execution/1",
