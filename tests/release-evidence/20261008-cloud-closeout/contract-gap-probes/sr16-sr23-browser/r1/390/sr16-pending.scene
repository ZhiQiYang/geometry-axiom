boundary 1 outline 100,200 2100,200 2100,1800 100,1800
boundary 2 outline 100,200 2100,200 2100,1800 100,1800
placement 1 on boundary 1 origin 0 0 0 u +x v +y
placement 2 on boundary 2 origin 0 0 0 u +x v +y
spec support_position_1 120
spec support_position_2 380
spec support_position_21 120
spec support_position_22 680
boundary-vertex-keys 1 outer 1 2 3 4 next-key 5
boundary-vertex-keys 2 outer 1 2 3 4 next-key 5
requires grid-subdivision-rules/1
grid-system 1 name-hex 53523136205352323320333930 main-along none u repeat 0 600 v repeat 0 400
grid-source-rule 1 key 1 name-hex 53686172656420706879736963616c2d737570706f72742072756c65 selector all-cells divide 3 2
grid-source-rule-highwater 1 next 2
grid-binding 1 on-boundary 1 from-system 1 vertex-key 1 cell -2 1 anchor 0 1 0 1
grid-binding 2 on-boundary 2 from-system 1 vertex-key 1 cell -2 1 anchor 0 1 0 1
grid 1 on 1 from-binding 1
grid 2 on 2 from-binding 2
timber 81 20 20 role boundary
timber 82 20 20 role boundary
timber 1 20 20 role primary
timber 2 20 20 role primary
timber 101 20 20 role boundary
timber 102 20 20 role boundary
timber 21 20 20 role primary
timber 22 20 20 role primary
timber 103 20 20 role secondary
timber 104 20 20 role secondary
guide 1 1 v spec:support_position_1
guide 2 1 v spec:support_position_2
guide 21 2 v spec:support_position_21
guide 22 2 v spec:support_position_22
guide 23 1 v gridrule:1:1:1:-2:1:u:0
guide 24 2 v gridrule:2:1:1:-2:1:u:0
place 81 on 1 at-face e0 +u +n
# R18 角材 81: onBoundary=true coversEdge=true boundaryEdge=0
place 82 on 1 at-face e2 +u +n
# R18 角材 82: onBoundary=true coversEdge=true boundaryEdge=2
place 1 on 1 at-line guide 1 +v +n
# R18 角材 1: onBoundary=false coversEdge=false boundaryEdge=-1
place 2 on 1 at-line guide 2 +v +n
# R18 角材 2: onBoundary=false coversEdge=false boundaryEdge=-1
place 101 on 2 at-face e0 +u +n
# R18 角材 101: onBoundary=true coversEdge=true boundaryEdge=0
place 102 on 2 at-face e2 +u +n
# R18 角材 102: onBoundary=true coversEdge=true boundaryEdge=2
place 21 on 2 at-line guide 21 +v +n
# R18 角材 21: onBoundary=false coversEdge=false boundaryEdge=-1
place 22 on 2 at-line guide 22 +v +n
# R18 角材 22: onBoundary=false coversEdge=false boundaryEdge=-1
place 103 on 1 at-line rule 1 1 1 -2 1 v 0 between t1 t2 +u +n
# R18 角材 103: onBoundary=false coversEdge=false boundaryEdge=-1
place 104 on 2 at-line rule 2 1 1 -2 1 v 0 between t21 t22 +u +n
# R18 角材 104: onBoundary=false coversEdge=false boundaryEdge=-1
canvas-pos boundary 1 60 60
canvas-pos boundary 2 60 360
canvas-pos grid-system 1 60 660
canvas-pos grid-binding 1 500 360
canvas-pos grid-binding 2 500 810
