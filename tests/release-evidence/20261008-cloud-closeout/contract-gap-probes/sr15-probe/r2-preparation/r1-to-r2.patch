+        # Keep the set exact and prove that the extra existing A is untouched.
+        rows = pv['gridBindings']
+        self.assertEqual(2, len(rows))
+        self.assertEqual({0, 1}, {r['id'] for r in rows})
+        by_id = {r['id']:r for r in rows}
+        live = {b['id']:b for b in before_anchor['world']['objects']['gridBindings']}
+        for identifier in (0, 1):
+            self.assertEqual(live[identifier],
+                             {k:v for k,v in by_id[identifier]['before'].items() if k!='preview'})
+        self.assertEqual(by_id[0]['before'], by_id[0]['after'], 'complete A preview must be unchanged')
+        old, new = by_id[1]['before'], by_id[1]['after']
+        self.assertEqual([{'num':1,'den':2},{'num':1,'den':2}], old['anchor'])
+        self.assertEqual([{'num':1,'den':3},{'num':1,'den':2}], new['anchor'])
+        self.assertEqual([1450,-400], old['translation'])
+        self.assertEqual([1600,-400], new['translation'])
+        self.assertEqual(['1450','-400'], old['translationExact'])
+        self.assertEqual(['1600','-400'], new['translationExact'])
+        changing = {'anchor','translation','translationExact','preview'}
+        self.assertEqual({k:v for k,v in old.items() if k not in changing},
+                         {k:v for k,v in new.items() if k not in changing})
+        # R32: U900 at source cells -1/0 plus translations1450/1600.
