+            self.assertEqual(coordinates, [line['coordinate'] for line in lines])
+            self.assertEqual([[{'a':[x,200],'b':[x,1800]}] for x in coordinates],
+                             [line['segments'] for line in lines])
+        self.assertEqual(old['preview']['axes']['v'], new['preview']['axes']['v'])
