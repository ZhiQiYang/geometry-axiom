+    def test_native_terminal_observations_roundtrip_and_reject_malformed_terminals(self):
+        _, native = self.run_case("one-local-joint-new-version")
+        bundle = {"schema": DATA_SCHEMA, "definitions": cases(), "receipts": [{"definition": case("one-local-joint-new-version"), "receipt": native["receipt"]}]}
+        status, assessed = self.post("assess", sessionId=self.session, data=bundle)
+        self.assertEqual(status, 200, assessed)
+        for terminal in [{"kind": "unknown"}, {"kind": "literal", "extra": True}, {"kind": "material", "id": "wood", "version": 0, "fingerprint": "0" * 64}, {"kind": "material", "id": "wood", "version": True, "fingerprint": "0" * 64}, {"kind": "material", "id": "wood", "version": 1, "fingerprint": "X" * 64}]:
+            invalid = deepcopy(bundle); invalid["receipts"][0]["receipt"]["observations"]["before"]["bindings"][0]["effective"][0]["A"]["terminal"] = terminal
+            with self.assertRaises(sys.modules["rule_case_workbench_adapter"].AdapterError): sys.modules["rule_case_workbench_adapter"]._observed_state(invalid["receipts"][0]["receipt"]["observations"]["before"])
+            status, refused = self.post("assess", sessionId=self.session, data=invalid)
+            self.assertEqual(status, 400, refused); self.assertEqual(refused["code"], "RECEIPT")
+
     def test_sessions_run_ids_and_expiry_are_bounded_without_permanent_open_close_leak(self):
